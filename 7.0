-- ===== ГЛОБАЛЬНЫЕ ДАННЫЕ =====
local ESPController = {
    playersData = {},
    connections = {},
    renderData = {},
    drawingPool = { lines = {}, corners = {}, texts = {}, tracers = {}, skeleton = {}, arrows = {} },
    isUnloaded = false,
    lastFullUpdate = 0,
    fullUpdateInterval = 0.033,
    lastSkeletonUpdate = 0,
    skeletonInterval = 0.066,
    lastTextUpdate = 0,
    textInterval = 0.1,
    lastArrowUpdate = 0,
    arrowInterval = 0.066,
    fpsSamples = {},
    fpsSum = 0,
    fpsCount = 0,
    currentFPS = 60,
    fpsLabel = nil,
    drawCountLabel = nil,
    fovCircle = Drawing.new("Circle"),
    rayParams = RaycastParams.new(),
    aimRayParams = RaycastParams.new(),
    oldNamecall = nil,
    oldIndex = nil,
}

ESPController.rayParams.FilterType = Enum.RaycastFilterType.Exclude
ESPController.rayParams.FilterDescendantsInstances = { Camera }
ESPController.aimRayParams.FilterType = Enum.RaycastFilterType.Exclude
ESPController.fovCircle.Visible = false
ESPController.fovCircle.NumSides = 60

-- ===== УТИЛИТЫ =====
local function safeDestroy(obj)
    if not obj then return end
    pcall(function()
        if typeof(obj) == "Instance" then obj:Destroy()
        else
            if obj.Remove then obj:Remove() else obj.Visible = false end
        end
    end)
end

local function removeFromPool(pool, obj)
    for i, v in ipairs(pool) do if v == obj then table.remove(pool, i) break end end
end

local function getFromPool(pool, type)
    for i, obj in ipairs(pool) do
        if obj and obj.Visible == false then
            return obj
        end
    end
    local new = Drawing.new(type)
    table.insert(pool, new)
    return new
end

local function hideAll(plrData)
    if plrData.drawings then
        for _, group in pairs(plrData.drawings) do
            if type(group) == "table" then
                for _, obj in pairs(group) do obj.Visible = false end
            elseif group then group.Visible = false end
        end
    end
    if plrData.skeletonLines then
        for _, l in pairs(plrData.skeletonLines) do l.Visible = false end
    end
    if plrData.texts then
        for _, t in pairs(plrData.texts) do t.Visible = false end
    end
    if plrData.tracer then plrData.tracer.Visible = false end
    if plrData.adornment then plrData.adornment.Visible = false end
    if plrData.arrow then
        for _, a in pairs(plrData.arrow) do a.Visible = false end
    end
    if plrData.highlight then plrData.highlight.Enabled = false end
end

local function destroyAll(plrData)
    if not plrData then return end
    if plrData.drawings then
        for _, group in pairs(plrData.drawings) do
            if type(group) == "table" then
                for _, obj in pairs(group) do
                    safeDestroy(obj)
                    removeFromPool(ESPController.drawingPool.lines, obj)
                    removeFromPool(ESPController.drawingPool.corners, obj)
                end
            else
                safeDestroy(group)
                removeFromPool(ESPController.drawingPool.lines, group)
            end
        end
        plrData.drawings = nil
    end
    if plrData.skeletonLines then
        for _, l in pairs(plrData.skeletonLines) do safeDestroy(l); removeFromPool(ESPController.drawingPool.skeleton, l) end
        plrData.skeletonLines = nil
    end
    if plrData.texts then
        for _, t in pairs(plrData.texts) do safeDestroy(t); removeFromPool(ESPController.drawingPool.texts, t) end
        plrData.texts = nil
    end
    if plrData.tracer then safeDestroy(plrData.tracer); removeFromPool(ESPController.drawingPool.tracers, plrData.tracer); plrData.tracer = nil end
    if plrData.adornment then safeDestroy(plrData.adornment); plrData.adornment = nil end
    if plrData.arrow then
        for _, a in pairs(plrData.arrow) do safeDestroy(a); removeFromPool(ESPController.drawingPool.arrows, a) end
        plrData.arrow = nil
    end
    if plrData.highlight then safeDestroy(plrData.highlight); plrData.highlight = nil end
end

local function isTeammate(plr)
    return LP.Team and plr.Team and LP.Team == plr.Team
end

local function cachePlayerParts(plr, char)
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local parts = {
        _player = plr,
        Character = char,
        humanoid = hum,
        Head = char:FindFirstChild("Head"),
        Torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"),
        HumanoidRootPart = char:FindFirstChild("HumanoidRootPart"),
        LeftArm = char:FindFirstChild("LeftArm") or char:FindFirstChild("LeftUpperArm"),
        RightArm = char:FindFirstChild("RightArm") or char:FindFirstChild("RightUpperArm"),
        LeftLeg = char:FindFirstChild("LeftLeg") or char:FindFirstChild("LeftUpperLeg"),
        RightLeg = char:FindFirstChild("RightLeg") or char:FindFirstChild("RightUpperLeg"),
        LeftLowerArm = char:FindFirstChild("LeftLowerArm"),
        RightLowerArm = char:FindFirstChild("RightLowerArm"),
        LeftHand = char:FindFirstChild("LeftHand"),
        RightHand = char:FindFirstChild("RightHand"),
        LeftLowerLeg = char:FindFirstChild("LeftLowerLeg"),
        RightLowerLeg = char:FindFirstChild("RightLowerLeg"),
        LeftFoot = char:FindFirstChild("LeftFoot"),
        RightFoot = char:FindFirstChild("RightFoot"),
    }
    if ESPController.playersData[plr] then ESPController.playersData[plr].parts = parts end
end

-- ===== ФУНКЦИИ ESP =====
local function getBoxColor(plr, visible, priority)
    if priority then return Config.ESP.PriorityColor end
    if Config.ESP.VisibleCheck then
        return visible and Config.ESP.VisibleColor or Config.ESP.OccludedColor
    else
        if Config.ESP.HideTeammates and isTeammate(plr) then
            return Config.ESP.AllyColor
        else
            return Config.ESP.EnemyColor
        end
    end
end

-- ===== ИСПРАВЛЕННАЯ updateBoxPosition (с закрывающим end) =====
local function updateBoxPosition(plrData, parts, rd)
    if rd.distance > Config.ESP.MaxDistance or rd.distance < Config.ESP.MinDistance or not rd.onScreen then
        if plrData.drawings then
            if plrData.drawings.lines then for _,l in pairs(plrData.drawings.lines) do l.Visible = false end end
            if plrData.drawings.corners then for _,c in pairs(plrData.drawings.corners) do c.Visible = false end end
        end
        return false
    end
    local head = parts.Head
    local hrp = parts.HumanoidRootPart
    if not head or not hrp then return false end
    local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0,0.5,0))
    local legPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0,3,0))
    local height = math.abs(headPos.Y - legPos.Y)
    if height < 2 then return false end
    local width = height * 0.8
    local left = rd.hrpPos.X - width/2
    local top = headPos.Y
    local right = left + width
    local bottom = top + height
    local color = getBoxColor(parts._player, rd.visible, rd.priority)
    if Config.ESP.BoxType == "2D" then
        if not plrData.drawings then plrData.drawings = {} end
        local lines = plrData.drawings.lines
        if not lines then
            lines = {}
            for i=1,4 do lines[i] = getFromPool(ESPController.drawingPool.lines, "Line") end
            plrData.drawings.lines = lines
        end
        lines[1].From = Vector2.new(left, top); lines[1].To = Vector2.new(right, top)
        lines[2].From = Vector2.new(right, top); lines[2].To = Vector2.new(right, bottom)
        lines[3].From = Vector2.new(right, bottom); lines[3].To = Vector2.new(left, bottom)
        lines[4].From = Vector2.new(left, bottom); lines[4].To = Vector2.new(left, top)
        for i=1,4 do
            lines[i].Color = color
            lines[i].Thickness = rd.priority and Config.ESP.BoxThickness+2 or Config.ESP.BoxThickness
            lines[i].Visible = true
        end
        if plrData.drawings.corners then for _,c in pairs(plrData.drawings.corners) do c.Visible = false end end
    elseif Config.ESP.BoxType == "Corner" then
        if not plrData.drawings then plrData.drawings = {} end
        local corners = plrData.drawings.corners
        if not corners then
            corners = {}
            for i=1,8 do corners[i] = getFromPool(ESPController.drawingPool.corners, "Line") end
            plrData.drawings.corners = corners
        end
        local len = 12
        corners[1].From = Vector2.new(left, top); corners[1].To = Vector2.new(left+len, top)
        corners[2].From = Vector2.new(left, top); corners[2].To = Vector2.new(left, top+len)
        corners[3].From = Vector2.new(right, top); corners[3].To = Vector2.new(right-len, top)
        corners[4].From = Vector2.new(right, top); corners[4].To = Vector2.new(right, top+len)
        corners[5].From = Vector2.new(left, bottom); corners[5].To = Vector2.new(left+len, bottom)
        corners[6].From = Vector2.new(left, bottom); corners[6].To = Vector2.new(left, bottom-len)
        corners[7].From = Vector2.new(right, bottom); corners[7].To = Vector2.new(right-len, bottom)
        corners[8].From = Vector2.new(right, bottom); corners[8].To = Vector2.new(right, bottom-len)
        for i=1,8 do
            corners[i].Color = color
            corners[i].Thickness = rd.priority and Config.ESP.BoxThickness+2 or Config.ESP.BoxThickness
            corners[i].Visible = true
        end
        if plrData.drawings.lines then for _,l in pairs(plrData.drawings.lines) do l.Visible = false end end
    elseif Config.ESP.BoxType == "3D" then
        if plrData.drawings then
            if plrData.drawings.lines then for _,l in pairs(plrData.drawings.lines) do l.Visible = false end end
            if plrData.drawings.corners then for _,c in pairs(plrData.drawings.corners) do c.Visible = false end end
        end
        if not Config.ESP.Chams then
            if not plrData.adornment then
                plrData.adornment = Instance.new("BoxHandleAdornment")
                plrData.adornment.AlwaysOnTop = true
                plrData.adornment.Transparency = 0.5
                plrData.adornment.ZIndex = 0
                plrData.adornment.Parent = hrp
            end
            plrData.adornment.Adornee = hrp
            plrData.adornment.Size = hrp.Size + Vector3.new(2,3,2)
            plrData.adornment.Color = color
            plrData.adornment.Visible = true
        end
    end
    return true
end

local function isVisibleCached(data, part)
    local now = os.clock()
    if now - data.lastVisibleUpdate < 0.2 then return data.visible end
    data.lastVisibleUpdate = now
    if not part then data.visible = false return false end
    local origin = Camera.CFrame.Position
    local delta = part.Position - origin
    local magnitude = delta.Magnitude
    if magnitude < 0.001 then data.visible = true; return true end
    local direction = delta / magnitude
    if LP.Character then ESPController.rayParams.FilterDescendantsInstances = { LP.Character, Camera }
    else ESPController.rayParams.FilterDescendantsInstances = { Camera } end
    local result = workspace:Raycast(origin, direction * magnitude, ESPController.rayParams)
    if not result then data.visible = true; return true end
    local distToHit = (result.Position - origin).Magnitude
    data.visible = distToHit >= magnitude - 0.5
    return data.visible
end

local function updateSkeletonOptimized(plrData, parts, rd)
    if not Config.ESP.Skeleton then return end
    local plr = parts._player
    if plr and plr.Character and (
        not parts.LeftLowerArm or not parts.RightLowerArm or
        not parts.LeftLowerLeg or not parts.RightLowerLeg
    ) then
        cachePlayerParts(plr, plr.Character)
        parts = ESPController.playersData[plr].parts
        if not parts then return end
    end
    local function getPos(part)
        if part then
            local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if onScreen then return pos end
        end
        return nil
    end
    local connectionsMap = {
        {parts.Head, parts.Torso}, {parts.Torso, parts.HumanoidRootPart},
        {parts.Torso, parts.LeftArm}, {parts.Torso, parts.RightArm},
        {parts.LeftArm, parts.LeftLowerArm}, {parts.RightArm, parts.RightLowerArm},
        {parts.LeftLowerArm, parts.LeftHand}, {parts.RightLowerArm, parts.RightHand},
        {parts.Torso, parts.LeftLeg}, {parts.Torso, parts.RightLeg},
        {parts.LeftLeg, parts.LeftLowerLeg}, {parts.RightLeg, parts.RightLowerLeg},
        {parts.LeftLowerLeg, parts.LeftFoot}, {parts.RightLowerLeg, parts.RightFoot},
    }
    if not plrData.skeletonLines then
        plrData.skeletonLines = {}
        for i = 1, #connectionsMap do plrData.skeletonLines[i] = getFromPool(ESPController.drawingPool.skeleton, "Line") end
    end
    local idx = 1
    local color = rd.priority and Config.ESP.PriorityColor or Config.ESP.SkeletonColor
    for _, conn in ipairs(connectionsMap) do
        local a = getPos(conn[1])
        local b = getPos(conn[2])
        if a and b then
            plrData.skeletonLines[idx].From = Vector2.new(a.X, a.Y)
            plrData.skeletonLines[idx].To = Vector2.new(b.X, b.Y)
            plrData.skeletonLines[idx].Color = color
            plrData.skeletonLines[idx].Thickness = Config.ESP.SkeletonThickness
            plrData.skeletonLines[idx].Visible = true
        else
            plrData.skeletonLines[idx].Visible = false
        end
        idx = idx + 1
    end
    for i = idx, #plrData.skeletonLines do if plrData.skeletonLines[i] then plrData.skeletonLines[i].Visible = false end end
end

local function updateTextOptimized(plrData, parts, rd)
    if not Config.ESP.ShowName and not Config.ESP.ShowHealth and not Config.ESP.ShowDistance then return end
    if rd.distance > Config.ESP.MaxDistance or rd.distance < Config.ESP.MinDistance or not rd.onScreen then
        if plrData.texts then
            for _, t in pairs(plrData.texts) do t.Visible = false end
        end
        return
    end
    local head = parts.Head
    if not head then return end
    local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0,0.5,0))
    local hum = parts.humanoid
    if not hum or hum.Health <= 0 then return end
    if not plrData.texts then plrData.texts = {} end
    local texts = plrData.texts
    local yOffset = 0
    if Config.ESP.ShowName then
        if not texts.NameText then
            texts.NameText = getFromPool(ESPController.drawingPool.texts, "Text")
            texts.NameText.Center = true
            texts.NameText.Outline = true
            texts.NameText.Font = 2
            texts.NameText.Size = 14
        end
        texts.NameText.Position = Vector2.new(rd.hrpPos.X, headPos.Y - 15 - yOffset)
        texts.NameText.Text = parts._player.DisplayName
        texts.NameText.Color = rd.priority and Config.ESP.PriorityColor or getBoxColor(parts._player, rd.visible, false)
        texts.NameText.Visible = true
        yOffset = yOffset + 16
    elseif texts.NameText then texts.NameText.Visible = false end

    if Config.ESP.ShowHealth then
        if not texts.HealthText then
            texts.HealthText = getFromPool(ESPController.drawingPool.texts, "Text")
            texts.HealthText.Center = true
            texts.HealthText.Outline = true
            texts.HealthText.Font = 2
            texts.HealthText.Size = 12
        end
        texts.HealthText.Position = Vector2.new(rd.hrpPos.X, headPos.Y - 15 - yOffset)
        texts.HealthText.Text = "❤️ " .. math.floor(hum.Health)
        texts.HealthText.Color = Color3.fromRGB(255,100,100)
        texts.HealthText.Visible = true
        yOffset = yOffset + 16
    elseif texts.HealthText then texts.HealthText.Visible = false end

    if Config.ESP.ShowDistance then
        if not texts.DistText then
            texts.DistText = getFromPool(ESPController.drawingPool.texts, "Text")
            texts.DistText.Center = true
            texts.DistText.Outline = true
            texts.DistText.Font = 2
            texts.DistText.Size = 12
        end
        texts.DistText.Position = Vector2.new(rd.hrpPos.X, headPos.Y - 15 - yOffset)
        texts.DistText.Text = math.floor(rd.distance) .. " studs"
        texts.DistText.Color = Color3.fromRGB(200,200,200)
        texts.DistText.Visible = true
    elseif texts.DistText then texts.DistText.Visible = false end
end

local function updateArrowOptimized(plrData, rd)
    if not Config.ESP.OffscreenArrows then
        if plrData.arrow then for _, a in pairs(plrData.arrow) do a.Visible = false end end
        return
    end
    if rd.onScreen then
        if plrData.arrow then for _, a in pairs(plrData.arrow) do a.Visible = false end end
        return
    end
    local hrp = rd.parts and rd.parts.HumanoidRootPart
    if not hrp then return end
    local camCF = Camera.CFrame
    local dir3 = (hrp.Position - camCF.Position).Unit
    local dir2 = Vector2.new(camCF.RightVector:Dot(dir3), -camCF.UpVector:Dot(dir3))
    if dir2.Magnitude < 0.001 then return end
    local dir = dir2.Unit
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local radius = math.min(Camera.ViewportSize.X, Camera.ViewportSize.Y) * 0.4
    local arrowPos = center + dir * radius
    arrowPos = Vector2.new(math.clamp(arrowPos.X, Config.ESP.ArrowSize, Camera.ViewportSize.X - Config.ESP.ArrowSize),
                           math.clamp(arrowPos.Y, Config.ESP.ArrowSize, Camera.ViewportSize.Y - Config.ESP.ArrowSize))
    if not plrData.arrow then
        plrData.arrow = { getFromPool(ESPController.drawingPool.arrows,"Line"), getFromPool(ESPController.drawingPool.arrows,"Line"), getFromPool(ESPController.drawingPool.arrows,"Line") }
        for _, a in pairs(plrData.arrow) do a.Thickness = 2 end
    end
    local len = Config.ESP.ArrowSize
    local tip = arrowPos + dir * len
    local perp = Vector2.new(-dir.Y, dir.X) * (len * 0.4)
    local color = rd.priority and Config.ESP.PriorityColor or Config.ESP.ArrowColor
    plrData.arrow[1].From = tip; plrData.arrow[1].To = arrowPos - dir * len
    plrData.arrow[2].From = tip; plrData.arrow[2].To = arrowPos + perp - dir * (len * 0.5)
    plrData.arrow[3].From = tip; plrData.arrow[3].To = arrowPos - perp - dir * (len * 0.5)
    for _, a in pairs(plrData.arrow) do a.Color = color; a.Visible = true end
end

-- ===== AIMBOT =====
local function getClosestPlayerToCursor()
    local closestPart = nil
    local shortestDistance = Config.Aimbot.FOVRadius
    local mousePos = UIS:GetMouseLocation()
    for plr, data in pairs(ESPController.playersData) do
        if Config.Aimbot.TeamCheck and isTeammate(plr) then continue end
        if Config.ESP.HideTeammates and isTeammate(plr) then continue end
        local parts = data.parts
        if not parts then continue end
        local targetPart = parts[Config.Aimbot.TargetPart]
        local hum = parts.humanoid
        if not targetPart or not hum or hum.Health <= 0 then continue end
        local distanceStuds = (Camera.CFrame.Position - targetPart.Position).Magnitude
        if distanceStuds > Config.ESP.MaxDistance then continue end
        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
        if not onScreen then continue end
        if Config.Aimbot.WallCheck then
            local origin = Camera.CFrame.Position
            local direction = targetPart.Position - origin
            ESPController.aimRayParams.FilterDescendantsInstances = { Camera, LP.Character, parts.Character }
            local raycastResult = workspace:Raycast(origin, direction, ESPController.aimRayParams)
            if raycastResult then continue end
        end
        local distPixels = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
        if distPixels < shortestDistance then
            shortestDistance = distPixels
            closestPart = targetPart
        end
    end
    return closestPart
end

-- ===== SILENT AIM (упрощённая проверка, без debug.traceback) =====
local function initSilentAimbot()
    local gmt = getrawmetatable(game)
    if not gmt then return end
    ESPController.oldNamecall = gmt.__namecall
    ESPController.oldIndex = gmt.__index
    setreadonly(gmt, false)

    gmt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if Config.Aimbot.SilentEnabled and not ESPController.isUnloaded then
            -- Проверяем только метод и self, без дорогого traceback
            if method == "Raycast" and self == workspace then
                local targetPart = getClosestPlayerToCursor()
                if targetPart and math.random() <= (Config.Aimbot.HitChance / 100) then
                    local args = {...}
                    local origin = args[1]
                    local newDirection = (targetPart.Position - origin).Unit * 9999
                    return ESPController.oldNamecall(self, origin, newDirection, args[3])
                end
            elseif (method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList") and self == workspace then
                local targetPart = getClosestPlayerToCursor()
                if targetPart and math.random() <= (Config.Aimbot.HitChance / 100) then
                    local args = {...}
                    local oldRay = args[1]
                    local newRay = Ray.new(oldRay.Origin, (targetPart.Position - oldRay.Origin).Unit * 9999)
                    args[1] = newRay
                    return ESPController.oldNamecall(self, unpack(args))
                end
            end
        end
        return ESPController.oldNamecall(self, ...)
    end)

    gmt.__index = newcclosure(function(self, key)
        if Config.Aimbot.SilentEnabled and not ESPController.isUnloaded and not UIS:GetFocusedTextBox() then
            if typeof(self) == "Instance" and self:IsA("Mouse") then
                if key == "Hit" then
                    local targetPart = getClosestPlayerToCursor()
                    if targetPart and math.random() <= (Config.Aimbot.HitChance / 100) then
                        return CFrame.new(targetPart.Position)
                    end
                elseif key == "Target" then
                    local targetPart = getClosestPlayerToCursor()
                    if targetPart and math.random() <= (Config.Aimbot.HitChance / 100) then
                        return targetPart
                    end
                end
            end
        end
        return ESPController.oldIndex(self, key)
    end)

    setreadonly(gmt, true)
end

-- ===== ОСНОВНОЙ РЕНДЕР =====
local function updateESP()
    if ESPController.isUnloaded or not Config.ESP.Enabled then
        for _, data in pairs(ESPController.playersData) do hideAll(data) end
        return
    end

    local now = os.clock()
    local fullUpdate = (now - ESPController.lastFullUpdate) >= ESPController.fullUpdateInterval
    local skeletonUpdate = (now - ESPController.lastSkeletonUpdate) >= ESPController.skeletonInterval
    local textUpdate = (now - ESPController.lastTextUpdate) >= ESPController.textInterval
    local arrowUpdate = (now - ESPController.lastArrowUpdate) >= ESPController.arrowInterval

    if fullUpdate then
        ESPController.lastFullUpdate = now
        for plr, data in pairs(ESPController.playersData) do
            local parts = data.parts
            local hrp = parts and parts.HumanoidRootPart
            local head = parts and parts.Head
            local hum = parts and parts.humanoid
            if not (hrp and head and hum and hum.Health > 0 and parts.Character.Parent) then
                hideAll(data)
                ESPController.renderData[plr] = nil
                continue
            end
            if Config.ESP.HideTeammates and isTeammate(plr) then
                hideAll(data)
                ESPController.renderData[plr] = nil
                continue
            end
            local hrpPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            if not onScreen then
                hideAll(data)
                ESPController.renderData[plr] = nil
                continue
            end
            local distance = (Camera.CFrame.Position - hrp.Position).Magnitude
            if distance > Config.ESP.MaxDistance or distance < Config.ESP.MinDistance then
                hideAll(data)
                ESPController.renderData[plr] = nil
                continue
            end
            local visible = false
            if Config.ESP.VisibleCheck then visible = isVisibleCached(data, head) end
            local rd = ESPController.renderData[plr] or {}
            rd.hrpPos = hrpPos
            rd.onScreen = onScreen
            rd.distance = distance
            rd.visible = visible
            rd.parts = parts
            ESPController.renderData[plr] = rd
        end

        if Config.ESP.PriorityTarget then
            local bestScore = -math.huge
            local bestPlr = nil
            local maxDist = Config.ESP.MaxDistance
            local halfWidth = Camera.ViewportSize.X / 2
            for plr, rd in pairs(ESPController.renderData) do
                if rd and rd.onScreen and not (Config.ESP.HideTeammates and isTeammate(plr)) then
                    local normDist = rd.distance / maxDist
                    local screenCenter = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
                    local distToCenter = (Vector2.new(rd.hrpPos.X, rd.hrpPos.Y) - screenCenter).Magnitude
                    local normPixels = distToCenter / halfWidth
                    local score = (rd.visible and 1 or 0) - normDist - normPixels * 0.5
                    if score > bestScore then
                        bestScore = score
                        bestPlr = plr
                    end
                end
            end
            for plr, rd in pairs(ESPController.renderData) do
                if rd then rd.priority = (plr == bestPlr) end
            end
        end

        for plr, rd in pairs(ESPController.renderData) do
            local data = ESPController.playersData[plr]
            if data and rd then
                updateBoxPosition(data, rd.parts, rd)
            end
        end
    end

    if skeletonUpdate then
        ESPController.lastSkeletonUpdate = now
        for plr, rd in pairs(ESPController.renderData) do
            local data = ESPController.playersData[plr]
            if data and rd then
                updateSkeletonOptimized(data, rd.parts, rd)
            end
        end
    end

    if textUpdate then
        ESPController.lastTextUpdate = now
        for plr, rd in pairs(ESPController.renderData) do
            local data = ESPController.playersData[plr]
            if data and rd then
                updateTextOptimized(data, rd.parts, rd)
                if Config.ESP.ShowTracer then
                    if not data.tracer then
                        data.tracer = getFromPool(ESPController.drawingPool.tracers, "Line")
                        data.tracer.Thickness = Config.ESP.TracerThickness
                    end
                    if rd.onScreen and rd.distance <= Config.ESP.MaxDistance and rd.distance >= Config.ESP.MinDistance then
                        local screenCenter = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
                        local footPos = Vector2.new(rd.hrpPos.X, rd.hrpPos.Y + 30)
                        data.tracer.From = screenCenter
                        data.tracer.To = footPos
                        data.tracer.Color = rd.priority and Config.ESP.PriorityColor or Config.ESP.TracerColor
                        data.tracer.Visible = true
                    else
                        data.tracer.Visible = false
                    end
                end
            end
        end
    end

    if arrowUpdate then
        ESPController.lastArrowUpdate = now
        for plr, rd in pairs(ESPController.renderData) do
            local data = ESPController.playersData[plr]
            if data and rd then
                updateArrowOptimized(data, rd)
            end
        end
    end
end

-- ===== FPS СЧЁТЧИК =====
local function createFPSDisplay()
    if ESPController.fpsLabel then return end
    local gui = Instance.new("ScreenGui")
    gui.Name = "FPSDisplay"
    gui.ResetOnSpawn = false
    gui.Parent = LP:WaitForChild("PlayerGui")
    ESPController.fpsLabel = Instance.new("TextLabel", gui)
    ESPController.fpsLabel.Size = UDim2.new(0,100,0,20)
    ESPController.fpsLabel.Position = UDim2.new(1,-110,0,10)
    ESPController.fpsLabel.BackgroundTransparency = 1
    ESPController.fpsLabel.TextColor3 = Color3.fromRGB(255,255,255)
    ESPController.fpsLabel.TextStrokeTransparency = 0.5
    ESPController.fpsLabel.Font = Enum.Font.SourceSansBold
    ESPController.fpsLabel.TextSize = 12
    ESPController.drawCountLabel = Instance.new("TextLabel", gui)
    ESPController.drawCountLabel.Size = UDim2.new(0,100,0,20)
    ESPController.drawCountLabel.Position = UDim2.new(1,-110,0,30)
    ESPController.drawCountLabel.BackgroundTransparency = 1
    ESPController.drawCountLabel.TextColor3 = Color3.fromRGB(200,200,200)
    ESPController.drawCountLabel.Font = Enum.Font.SourceSans
    ESPController.drawCountLabel.TextSize = 10
end

local function updateFPSDisplay(dt)
    if not Config.ESP.ShowFPS then
        if ESPController.fpsLabel then ESPController.fpsLabel.Visible = false end
        if ESPController.drawCountLabel then ESPController.drawCountLabel.Visible = false end
        return
    end
    if not ESPController.fpsLabel then createFPSDisplay() end
    ESPController.fpsLabel.Visible = true
    ESPController.drawCountLabel.Visible = true
    local instantFPS = 1 / dt
    ESPController.fpsSum = ESPController.fpsSum + instantFPS
    ESPController.fpsCount = ESPController.fpsCount + 1
    if ESPController.fpsCount >= 30 then
        ESPController.currentFPS = ESPController.fpsSum / ESPController.fpsCount
        ESPController.fpsSum = 0
        ESPController.fpsCount = 0
    end
    local totalDrawings = 0
    for _, pool in pairs(ESPController.drawingPool) do totalDrawings = totalDrawings + #pool end
    ESPController.fpsLabel.Text = string.format("FPS: %.1f", ESPController.currentFPS)
    ESPController.drawCountLabel.Text = string.format("Draw: %d", totalDrawings)
end

-- ===== КАМЕРНЫЙ АИМБОТ =====
local function updateAimbotLoop()
    if ESPController.isUnloaded then return end
    local fov = ESPController.fovCircle
    if fov then
        fov.Position = UIS:GetMouseLocation()
        fov.Radius = Config.Aimbot.FOVRadius
        fov.Color = Config.Aimbot.FOVColor
        fov.Thickness = Config.Aimbot.FOVThickness
        fov.Filled = Config.Aimbot.FilledFOV
        fov.Transparency = Config.Aimbot.FOVTransparency
        fov.Visible = Config.Aimbot.ShowFOV and (Config.Aimbot.CameraEnabled or Config.Aimbot.SilentEnabled)
    end
    if Config.Aimbot.CameraEnabled and not UIS:GetFocusedTextBox() then
        local key = Config.Aimbot.AimbotKey
        local pressed = false
        if key then
            if key.EnumType == Enum.UserInputType then pressed = UIS:IsMouseButtonPressed(key)
            elseif key.EnumType == Enum.KeyCode then pressed = UIS:IsKeyDown(key) end
        end
        if pressed then
            local targetPart = getClosestPlayerToCursor()
            if targetPart then
                local current = Camera.CFrame
                local target = CFrame.new(current.Position, targetPart.Position)
                Camera.CFrame = current:Lerp(target, Config.Aimbot.Smoothness)
            end
        end
    end
end

-- ===== SETUP PLAYER =====
local function setupPlayer(plr)
    if plr == LP then return end
    local oldData = ESPController.playersData[plr]
    if oldData then hideAll(oldData) end
    if ESPController.connections[plr] then
        for _, conn in pairs(ESPController.connections[plr]) do if conn then conn:Disconnect() end end
    end
    ESPController.playersData[plr] = {
        parts = {},
        drawings = nil,
        skeletonLines = nil,
        texts = nil,
        tracer = nil,
        adornment = nil,
        arrow = nil,
        highlight = nil,
        visible = false,
        lastVisibleUpdate = 0,
    }
    ESPController.renderData[plr] = nil
    ESPController.connections[plr] = {}

    local charAddedConn = plr.CharacterAdded:Connect(function(char)
        task.spawn(function()
            if LP.Character then ESPController.rayParams.FilterDescendantsInstances = { LP.Character, Camera } end
            local hrp = char:WaitForChild("HumanoidRootPart", 5)
            local head = char:WaitForChild("Head", 5)
            if hrp and head and char.Parent then
                cachePlayerParts(plr, char)
                local data = ESPController.playersData[plr]
                if data then
                    if data.highlight then safeDestroy(data.highlight); data.highlight = nil end
                    if Config.ESP.Chams then
                        local hl = Instance.new("Highlight")
                        hl.Name = "GlupostESPHighlight"
                        hl.FillColor = Config.ESP.ChamsVisibleColor
                        hl.OutlineColor = Config.ESP.ChamsOccludedColor
                        hl.FillTransparency = Config.ESP.ChamsTransparency
                        hl.Parent = char
                        data.highlight = hl
                    end
                end
            end
        end)
    end)
    local charRemovingConn = plr.CharacterRemoving:Connect(function()
        if ESPController.playersData[plr] then hideAll(ESPController.playersData[plr]) end
    end)
    ESPController.connections[plr].CharacterAdded = charAddedConn
    ESPController.connections[plr].CharacterRemoving = charRemovingConn
    if plr.Character then cachePlayerParts(plr, plr.Character) end
end

-- ===== ИНИЦИАЛИЗАЦИЯ И ВЫГРУЗКА =====
local function initESP()
    for _, player in ipairs(Players:GetPlayers()) do setupPlayer(player) end
    ESPController.playerAddedConn = Players.PlayerAdded:Connect(setupPlayer)
    ESPController.playerRemovingConn = Players.PlayerRemoving:Connect(function(player)
        if ESPController.playersData[player] then
            destroyAll(ESPController.playersData[player])
            ESPController.playersData[player] = nil
        end
        if ESPController.connections[player] then
            for _, conn in pairs(ESPController.connections[player]) do if conn then conn:Disconnect() end end
            ESPController.connections[player] = nil
        end
        ESPController.renderData[player] = nil
    end)
end

local function unloadHub()
    if ESPController.isUnloaded then return end
    ESPController.isUnloaded = true
    if ESPController.playerAddedConn then ESPController.playerAddedConn:Disconnect() end
    if ESPController.playerRemovingConn then ESPController.playerRemovingConn:Disconnect() end
    if ESPController.renderSteppedConn then ESPController.renderSteppedConn:Disconnect() end
    if ESPController.heartbeatConn then ESPController.heartbeatConn:Disconnect() end
    if ESPController.hotkeyConn then ESPController.hotkeyConn:Disconnect() end
    for plr, userConns in pairs(ESPController.connections) do
        for _, conn in pairs(userConns) do if conn then conn:Disconnect() end end
    end
    table.clear(ESPController.connections)
    for plr, data in pairs(ESPController.playersData) do destroyAll(data) end
    table.clear(ESPController.playersData)
    table.clear(ESPController.renderData)
    for _, pool in pairs(ESPController.drawingPool) do
        for _, obj in ipairs(pool) do safeDestroy(obj) end
        table.clear(pool)
    end
    pcall(function() ESPController.fovCircle:Remove() end)
    if ESPController.fpsLabel then ESPController.fpsLabel.Visible = false end
    if ESPController.drawCountLabel then ESPController.drawCountLabel.Visible = false end
    local gmt = getrawmetatable(game)
    if gmt and ESPController.oldNamecall and ESPController.oldIndex then
        setreadonly(gmt, false)
        gmt.__namecall = ESPController.oldNamecall
        gmt.__index = ESPController.oldIndex
        setreadonly(gmt, true)
    end
    Library:Unload()
end

-- ===== ГОРЯЧИЕ КЛАВИШИ =====
local function setupHotkeys()
    ESPController.hotkeyConn = UIS.InputBegan:Connect(function(input,gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.F1 then
            Config.ESP.Enabled = not Config.ESP.Enabled
            if Options.ESPEnabled then Options.ESPEnabled:SetValue(Config.ESP.Enabled) end
        elseif input.KeyCode == Enum.KeyCode.F2 then
            local types = {"2D","3D","Corner"}
            local idx = table.find(types, Config.ESP.BoxType) or 1
            idx = idx % 3 + 1
            Config.ESP.BoxType = types[idx]
            if Options.BoxType then Options.BoxType:SetValue(Config.ESP.BoxType) end
        elseif input.KeyCode == Enum.KeyCode.F3 then
            Config.ESP.Skeleton = not Config.ESP.Skeleton
            if Options.SkeletonEnabled then Options.SkeletonEnabled:SetValue(Config.ESP.Skeleton) end
        end
    end)
end

