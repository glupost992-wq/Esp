-- ===== ИНИЦИАЛИЗАЦИЯ И ВЫГРУЗКА =====
local function initESP()
    for _,p in ipairs(Players:GetPlayers()) do setupPlayer(p) end
    playerAddedConn=Players.PlayerAdded:Connect(setupPlayer)
    playerRemovingConn=Players.PlayerRemoving:Connect(function(p)
        if playersData[p] then destroyAll(playersData[p]); playersData[p]=nil end
        if connections[p] then for _,c in pairs(connections[p]) do if c then c:Disconnect() end end connections[p]=nil end
        renderData[p]=nil
        predictionCache[p] = nil
        threatScoreCache[p] = nil
    end)
end

function unloadHub()
    if isUnloaded then return end
    isUnloaded=true
    destroySpinbot()
    removeSilentHook()
    if recoilConn then recoilConn:Disconnect() end
    if playerAddedConn then playerAddedConn:Disconnect() end
    if playerRemovingConn then playerRemovingConn:Disconnect() end
    if renderSteppedConn then renderSteppedConn:Disconnect() end
    if hotkeyConn then hotkeyConn:Disconnect() end
    for _,conns in pairs(connections) do for _,c in pairs(conns) do if c then c:Disconnect() end end end
    table.clear(connections)
    for _,d in pairs(playersData) do destroyAll(d) end
    table.clear(playersData)
    table.clear(renderData)
    for _,pool in pairs(drawingPool) do for _,o in ipairs(pool) do safeDestroy(o) end table.clear(pool) end
    pcall(function() fovDraw:Remove() squareFOV:Remove() end)
    if fpsLabel then fpsLabel.Visible=false end
    if drawCountLabel then drawCountLabel.Visible=false end
    if frameTimeLabel then frameTimeLabel.Visible=false end
    predictionCache = {}
    threatScoreCache = {}
    recoilPatterns = {}
    recoilPatternOrder = {}
    Library:Unload()
end

local function setupHotkeys()
    hotkeyConn=UIS.InputBegan:Connect(function(inp,gp)
        if gp then return end
        if inp.KeyCode==Enum.KeyCode.F1 then
            Config.ESP.Enabled=not Config.ESP.Enabled
            if Options.ESPEnabled then Options.ESPEnabled:SetValue(Config.ESP.Enabled) end
        elseif inp.KeyCode==Enum.KeyCode.F2 then
            local types={"2D","3D","Corner"} local idx=table.find(types,Config.ESP.BoxType) or 1 idx=idx%3+1 Config.ESP.BoxType=types[idx]
            if Options.BoxType then Options.BoxType:SetValue(Config.ESP.BoxType) end
        elseif inp.KeyCode==Enum.KeyCode.F3 then
            Config.ESP.Skeleton=not Config.ESP.Skeleton
            if Options.SkeletonEnabled then Options.SkeletonEnabled:SetValue(Config.ESP.Skeleton) end
        end
    end)
end

-- RCS вызов при каждом клике
recoilConn = UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        if Config.Aimbot.RCSEnabled and Config.Aimbot.RCSAdaptiveLearning then
            recordRecoilStart()
        end
    end
end)

initESP()
initSilentAimbot()
renderSteppedConn=RunService.RenderStepped:Connect(function(dt)
    if isUnloaded then return end
    local success, err = pcall(function()
        updatePredictionCache()
        updateFPSDisplay(dt)
        updateAimbotLoop(dt)
        updateESP()
        updateFOV()
    end)
    if not success then warn("glupost hub error: ", err) end
end)
setupHotkeys()

print("glupost hub v16.3 FINAL loaded. All known issues resolved.")

