-- glupost hub v11.0 (ESP + Aimbot + Silent, полная версия)
local repo = "https://raw.githubusercontent.com/deividcomsono/Obsidian/main/"
local Library = loadstring(game:HttpGet(repo .. "Library.lua"))()
local ThemeManager = loadstring(game:HttpGet(repo .. "addons/ThemeManager.lua"))()
local SaveManager = loadstring(game:HttpGet(repo .. "addons/SaveManager.lua"))()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LP = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local UIS = game:GetService("UserInputService")

if not Drawing then error("Drawing API not supported") end

-- ===== НАСТРОЙКИ =====
local ESP = {
    Enabled = true,
    BoxType = "2D",
    BoxColor = Color3.fromRGB(0,255,0),
    BoxThickness = 2,
    Skeleton = false,
    SkeletonColor = Color3.fromRGB(255,0,0),
    SkeletonThickness = 2,
    HideTeammates = false,
    MaxDistance = 500,
    MinDistance = 0,
    ShowHealth = true,
    ShowName = true,
    ShowTracer = false,
    ShowDistance = true,
    TracerColor = Color3.fromRGB(255,255,255),
    TracerThickness = 1,
    OffscreenArrows = true,
    ArrowColor = Color3.fromRGB(255,255,0),
    ArrowSize = 20,
    VisibleCheck = true,
    VisibleColor = Color3.fromRGB(0,255,0),
    OccludedColor = Color3.fromRGB(255,200,0),
    Chams = false,
    ChamsVisibleColor = Color3.fromRGB(0,255,0),
    ChamsOccludedColor = Color3.fromRGB(255,0,0),
    ChamsTransparency = 0.5,
    PriorityTarget = true,
    PriorityColor = Color3.fromRGB(255,215,0),
    EnemyColor = Color3.fromRGB(255,0,0),
    AllyColor = Color3.fromRGB(0,255,0),
    ShowFPS = false,
    CameraEnabled = false,
    SilentEnabled = false,
    TargetPart = "Head",
    TeamCheck = true,
    WallCheck = true,
    Smoothness = 0.3,
    HitChance = 100,
    ShowFOV = false,
    FOVRadius = 150,
    FOVColor = Color3.fromRGB(255,255,255),
    FOVThickness = 2,
    FilledFOV = false,
    FOVTransparency = 0.3,
    AimbotKey = Enum.UserInputType.MouseButton2,
}

-- ===== ГЛОБАЛЬНЫЕ ДАННЫЕ =====
local playersData = {}
local connections = {}
local renderData = {}
local drawingPool = { lines = {}, corners = {}, texts = {}, tracers = {}, skeleton = {}, arrows = {} }
local renderSteppedConn, heartbeatConn, playerAddedConn, playerRemovingConn = nil, nil, nil, nil
local hotkeyConn = nil
local isUnloaded = false
local lastHeartbeat = 0
local heartbeatInterval = 1/20
local fpsRing = {}
local fpsIndex = 0
local currentFPS = 60
local fpsLabel = nil
local drawCountLabel = nil

local fovCircle = Drawing.new("Circle")
fovCircle.Visible = false
fovCircle.NumSides = 60

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.FilterDescendantsInstances = { Camera }

local aimRayParams = RaycastParams.new()
aimRayParams.FilterType = Enum.RaycastFilterType.Exclude

local oldNamecall = nil
local oldIndex = nil

-- ===== ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ =====
local function safeDestroy(obj)
    if not obj then return end
    pcall(function()
        if typeof(obj) == "Instance" then obj:Destroy()
        else if obj.Remove then obj:Remove() else obj.Visible = false end end
    end)
end

local function removeFromPool(pool, obj)
    for i, v in ipairs(pool) do if v == obj then table.remove(pool, i) break end end
end

local function getFromPool(pool, type)
    for i, obj in ipairs(pool) do
        local ok, visible = pcall(function() return obj.Visible end)
        if ok and visible == false then return obj end
    end
    local new = Drawing.new(type)
    table.insert(pool, new)
    return new
end

local function hideAll(plrData)
    if plrData.drawings then
        for _, group in pairs(plrData.drawings) do
            if type(group) == "table" then
                for _, obj in pairs(group) do obj.Visible = false end
            elseif group then group.Visible = false end
        end
    end
    if plrData.skeletonLines then
        for _, l in pairs(plrData.skeletonLines) do l.Visible = false end
    end
    if plrData.texts then
        for _, t in pairs(plrData.texts) do t.Visible = false end
    end
    if plrData.tracer then plrData.tracer.Visible = false end
    if plrData.adornment then plrData.adornment.Visible = false end
    if plrData.arrow then
        for _, a in pairs(plrData.arrow) do a.Visible = false end
    end
    if plrData.highlight then plrData.highlight.Enabled = false end
end

local function destroyAll(plrData)
    if not plrData then return end
    if plrData.drawings then
        for _, group in pairs(plrData.drawings) do
            if type(group) == "table" then
                for _, obj in pairs(group) do
                    safeDestroy(obj)
                    removeFromPool(drawingPool.lines, obj)
                    removeFromPool(drawingPool.corners, obj)
                end
            else
                safeDestroy(group)
                removeFromPool(drawingPool.lines, group)
            end
        end
        plrData.drawings = nil
    end
    if plrData.skeletonLines then
        for _, l in pairs(plrData.skeletonLines) do safeDestroy(l); removeFromPool(drawingPool.skeleton, l) end
        plrData.skeletonLines = nil
    end
    if plrData.texts then
        for _, t in pairs(plrData.texts) do safeDestroy(t); removeFromPool(drawingPool.texts, t) end
        plrData.texts = nil
    end
    if plrData.tracer then safeDestroy(plrData.tracer); removeFromPool(drawingPool.tracers, plrData.tracer); plrData.tracer = nil end
    if plrData.adornment then safeDestroy(plrData.adornment); plrData.adornment = nil end
    if plrData.arrow then
        for _, a in pairs(plrData.arrow) do safeDestroy(a); removeFromPool(drawingPool.arrows, a) end
        plrData.arrow = nil
    end
    if plrData.highlight then safeDestroy(plrData.highlight); plrData.highlight = nil end
end

local function cachePlayerParts(plr, char)
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local parts = {
        _player = plr,
        Character = char,
        humanoid = hum,
        Head = char:FindFirstChild("Head"),
        Torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"),
        HumanoidRootPart = char:FindFirstChild("HumanoidRootPart"),
        LeftArm = char:FindFirstChild("LeftArm") or char:FindFirstChild("LeftUpperArm"),
        RightArm = char:FindFirstChild("RightArm") or char:FindFirstChild("RightUpperArm"),
        LeftLeg = char:FindFirstChild("LeftLeg") or char:FindFirstChild("LeftUpperLeg"),
        RightLeg = char:FindFirstChild("RightLeg") or char:FindFirstChild("RightUpperLeg"),
        LeftLowerArm = char:FindFirstChild("LeftLowerArm"),
        RightLowerArm = char:FindFirstChild("RightLowerArm"),
        LeftHand = char:FindFirstChild("LeftHand"),
        RightHand = char:FindFirstChild("RightHand"),
        LeftLowerLeg = char:FindFirstChild("LeftLowerLeg"),
        RightLowerLeg = char:FindFirstChild("RightLowerLeg"),
        LeftFoot = char:FindFirstChild("LeftFoot"),
        RightFoot = char:FindFirstChild("RightFoot"),
    }
    if playersData[plr] then playersData[plr].parts = parts end
end

-- ===== SETUP PLAYER =====
local function setupPlayer(plr)
    if plr == LP then return end
    local oldData = playersData[plr]
    if oldData then hideAll(oldData) end
    if connections[plr] then
        for _, conn in pairs(connections[plr]) do if conn then conn:Disconnect() end end
    end
    playersData[plr] = {
        parts = {},
        drawings = nil,
        skeletonLines = nil,
        texts = nil,
        tracer = nil,
        adornment = nil,
        arrow = nil,
        highlight = nil,
        visible = false,
        lastVisibleUpdate = 0,
    }
    renderData[plr] = nil
    connections[plr] = {}

    local charAddedConn = plr.CharacterAdded:Connect(function(char)
        task.spawn(function()
            if LP.Character then rayParams.FilterDescendantsInstances = { LP.Character, Camera } end
            local hrp = char:WaitForChild("HumanoidRootPart", 5)
            local head = char:WaitForChild("Head", 5)
            if hrp and head and char.Parent then
                cachePlayerParts(plr, char)
                local data = playersData[plr]
                if data then
                    if data.highlight then safeDestroy(data.highlight); data.highlight = nil end
                    if ESP.Chams then
                        local hl = Instance.new("Highlight")
                        hl.Name = "GlupostESPHighlight"
                        hl.FillColor = ESP.ChamsVisibleColor
                        hl.OutlineColor = ESP.ChamsOccludedColor
                        hl.FillTransparency = ESP.ChamsTransparency
                        hl.Parent = char
                        data.highlight = hl
                    end
                end
            end
        end)
    end)
    local charRemovingConn = plr.CharacterRemoving:Connect(function()
        if playersData[plr] then hideAll(playersData[plr]) end
    end)
    connections[plr].CharacterAdded = charAddedConn
    connections[plr].CharacterRemoving = charRemovingConn
    if plr.Character then cachePlayerParts(plr, plr.Character) end
end

-- ===== ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ESP =====
local function isTeammate(plr)
    if not ESP.HideTeammates then return false end
    return LP.Team and plr.Team and LP.Team == plr.Team
end

local function getBoxColor(plr, visible, priority)
    if priority then return ESP.PriorityColor end
    if ESP.VisibleCheck then return visible and ESP.VisibleColor or ESP.OccludedColor
    else return isTeammate(plr) and ESP.AllyColor or ESP.EnemyColor end
end

local function isVisibleCached(data, part)
    local now = os.clock()
    if now - data.lastVisibleUpdate < 0.2 then return data.visible end
    data.lastVisibleUpdate = now
    if not part then data.visible = false return false end
    local origin = Camera.CFrame.Position
    local delta = part.Position - origin
    local magnitude = delta.Magnitude
    if magnitude < 0.001 then data.visible = true; return true end
    local direction = delta / magnitude
    if LP.Character then rayParams.FilterDescendantsInstances = { LP.Character, Camera }
    else rayParams.FilterDescendantsInstances = { Camera } end
    local result = workspace:Raycast(origin, direction * magnitude, rayParams)
    if not result then data.visible = true; return true end
    local distToHit = (result.Position - origin).Magnitude
    data.visible = distToHit >= magnitude - 0.5
    return data.visible
end

-- ===== ФУНКЦИЯ ВЫБОРА ЦЕЛИ ДЛЯ АИМБОТА =====
local function getClosestPlayerToCursor()
    local closestPart = nil
    local shortestDistance = ESP.FOVRadius
    local mousePos = UIS:GetMouseLocation()

    for plr, data in pairs(playersData) do
        if ESP.TeamCheck and isTeammate(plr) then continue end
        local parts = data.parts
        if not parts then continue end
        local targetPart = parts[ESP.TargetPart]
        local hum = parts.humanoid
        if not targetPart or not hum or hum.Health <= 0 then continue end

        local distanceStuds = (Camera.CFrame.Position - targetPart.Position).Magnitude
        if distanceStuds > ESP.MaxDistance then continue end

        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
        if not onScreen then continue end

        if ESP.WallCheck then
            local origin = Camera.CFrame.Position
            local direction = targetPart.Position - origin
            aimRayParams.FilterDescendantsInstances = { Camera, LP.Character, parts.Character }
            local raycastResult = workspace:Raycast(origin, direction, aimRayParams)
            if raycastResult then continue end
        end

        local distPixels = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
        if distPixels < shortestDistance then
            shortestDistance = distPixels
            closestPart = targetPart
        end
    end
    return closestPart
end

-- ===== SILENT AIMBOT =====
local function initSilentAimbot()
    local gmt = getrawmetatable(game)
    if not gmt then return end
    oldNamecall = gmt.__namecall
    oldIndex = gmt.__index
    setreadonly(gmt, false)

    gmt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        if ESP.SilentEnabled and isAimbotKeyPressed() and not UIS:GetFocusedTextBox() and not isUnloaded then
            if method == "Raycast" and self == workspace then
                local targetPart = getClosestPlayerToCursor()
                if targetPart and math.random(1,100) <= ESP.HitChance then
                    local origin = args[1]
                    local newDirection = (targetPart.Position - origin).Unit * 9999
                    return oldNamecall(self, origin, newDirection, args[3])
                end
            end
        end
        return oldNamecall(self, ...)
    end)

    gmt.__index = newcclosure(function(self, key)
        if ESP.SilentEnabled and isAimbotKeyPressed() and not UIS:GetFocusedTextBox() and not isUnloaded then
            if typeof(self) == "Instance" and self:IsA("Mouse") then
                if key == "Hit" then
                    local targetPart = getClosestPlayerToCursor()
                    if targetPart and math.random(1,100) <= ESP.HitChance then
                        return CFrame.new(targetPart.Position)
                    end
                elseif key == "Target" then
                    local targetPart = getClosestPlayerToCursor()
                    if targetPart and math.random(1,100) <= ESP.HitChance then
                        return targetPart
                    end
                end
            end
        end
        return oldIndex(self, key)
    end)
    setreadonly(gmt, true)
end

-- ===== ОТРИСОВКА ESP =====
local function drawCornerBox(plrData, parts, hrpPos, distance, visible, priority)
    if distance > ESP.MaxDistance or distance < ESP.MinDistance then return end
    local head = parts.Head
    local hrp = parts.HumanoidRootPart
    if not head or not hrp then return end
    local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
    local legPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
    local height = math.abs(headPos.Y - legPos.Y)
    if height < 2 then return end
    local width = height * 0.8
    local left = hrpPos.X - width/2
    local top = headPos.Y
    local right = left + width
    local bottom = top + height
    local color = getBoxColor(parts._player, visible, priority)
    if not plrData.drawings then plrData.drawings = {} end
    local corners = plrData.drawings.corners
    if not corners then
        corners = {}
        for i = 1, 8 do corners[i] = getFromPool(drawingPool.corners, "Line") end
        plrData.drawings.corners = corners
    end
    local len = 12
    corners[1].From = Vector2.new(left, top); corners[1].To = Vector2.new(left + len, top)
    corners[2].From = Vector2.new(left, top); corners[2].To = Vector2.new(left, top + len)
    corners[3].From = Vector2.new(right, top); corners[3].To = Vector2.new(right - len, top)
    corners[4].From = Vector2.new(right, top); corners[4].To = Vector2.new(right, top + len)
    corners[5].From = Vector2.new(left, bottom); corners[5].To = Vector2.new(left + len, bottom)
    corners[6].From = Vector2.new(left, bottom); corners[6].To = Vector2.new(left, bottom - len)
    corners[7].From = Vector2.new(right, bottom); corners[7].To = Vector2.new(right - len, bottom)
    corners[8].From = Vector2.new(right, bottom); corners[8].To = Vector2.new(right, bottom - len)
    for i = 1, 8 do
        corners[i].Color = color
        corners[i].Thickness = ESP.BoxThickness
        corners[i].Visible = true
    end
end

local function draw3DBox(plrData, parts, visible, priority)
    if not ESP.Enabled or isTeammate(parts._player) or ESP.Chams then
        if plrData.adornment then plrData.adornment.Visible = false end
        return
    end
    local hrp = parts.HumanoidRootPart
    if not hrp then return end
    if not plrData.adornment or not plrData.adornment.Parent then
        if plrData.adornment then plrData.adornment:Destroy() end
        plrData.adornment = Instance.new("BoxHandleAdornment")
        plrData.adornment.AlwaysOnTop = true
        plrData.adornment.Transparency = 0.5
        plrData.adornment.ZIndex = 0
        plrData.adornment.Parent = hrp
    end
    plrData.adornment.Adornee = hrp
    plrData.adornment.Size = hrp.Size + Vector3.new(2,3,2)
    plrData.adornment.Color = getBoxColor(parts._player, visible, priority)
    plrData.adornment.Visible = true
end

local function drawSkeleton(plrData, parts, arrowData)
    if not ESP.Skeleton then return end
    local plr = parts._player
    if plr and plr.Character and (
        not parts.LeftLowerArm or not parts.RightLowerArm or
        not parts.LeftLowerLeg or not parts.RightLowerLeg
    ) then
        cachePlayerParts(plr, plr.Character)
        parts = playersData[plr].parts
        if not parts then return
    end
    local function getPos(part)
        if part then
            local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if onScreen then return pos end
        end
        return nil
    end
    local connectionsMap = {
        {parts.Head, parts.Torso}, {parts.Torso, parts.HumanoidRootPart},
        {parts.Torso, parts.LeftArm}, {parts.Torso, parts.RightArm},
        {parts.LeftArm, parts.LeftLowerArm}, {parts.RightArm, parts.RightLowerArm},
        {parts.LeftLowerArm, parts.LeftHand}, {parts.RightLowerArm, parts.RightHand},
        {parts.Torso, parts.LeftLeg}, {parts.Torso, parts.RightLeg},
        {parts.LeftLeg, parts.LeftLowerLeg}, {parts.RightLeg, parts.RightLowerLeg},
        {parts.LeftLowerLeg, parts.LeftFoot}, {parts.RightLowerLeg, parts.RightFoot},
    }
    if not plrData.skeletonLines then
        plrData.skeletonLines = {}
        for i = 1, #connectionsMap do plrData.skeletonLines[i] = getFromPool(drawingPool.skeleton, "Line") end
    end
    local idx = 1
    local color = arrowData.priority and ESP.PriorityColor or ESP.SkeletonColor
    for _, conn in ipairs(connectionsMap) do
        local a = getPos(conn[1])
        local b = getPos(conn[2])
        if a and b then
            plrData.skeletonLines[idx].From = Vector2.new(a.X, a.Y)
            plrData.skeletonLines[idx].To = Vector2.new(b.X, b.Y)
            plrData.skeletonLines[idx].Color = color
            plrData.skeletonLines[idx].Thickness = ESP.SkeletonThickness
            plrData.skeletonLines[idx].Visible = true
        else
            plrData.skeletonLines[idx].Visible = false
        end
        idx = idx + 1
    end
    for i = idx, #plrData.skeletonLines do if plrData.skeletonLines[i] then plrData.skeletonLines[i].Visible = false end end
end

local function drawTexts(plrData, parts, arrowData)
    if not ESP.ShowName and not ESP.ShowHealth and not ESP.ShowDistance then return end
    if arrowData.distance > ESP.MaxDistance or arrowData.distance < ESP.MinDistance or not arrowData.onScreen then
        if plrData.texts then
            for _, t in pairs(plrData.texts) do t.Visible = false end
        end
        return
    end
    local head = parts.Head
    if not head then return end
    local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0,0.5,0))
    local hum = parts.humanoid
    if not hum or hum.Health <= 0 then return end
    if not plrData.texts then plrData.texts = {} end
    local texts = plrData.texts
    local yOffset = 0
    if ESP.ShowName then
        if not texts.NameText then
            texts.NameText = getFromPool(drawingPool.texts, "Text")
            texts.NameText.Center = true
            texts.NameText.Outline = true
            texts.NameText.Font = 2
            texts.NameText.Size = 14
        end
        texts.NameText.Position = Vector2.new(arrowData.hrpPos.X, headPos.Y - 15 - yOffset)
        texts.NameText.Text = parts._player.DisplayName
        texts.NameText.Color = arrowData.priority and ESP.PriorityColor or getBoxColor(parts._player, arrowData.visible, false)
        texts.NameText.Visible = true
        yOffset = yOffset + 16
    elseif texts.NameText then texts.NameText.Visible = false end

    if ESP.ShowHealth then
        if not texts.HealthText then
            texts.HealthText = getFromPool(drawingPool.texts, "Text")
            texts.HealthText.Center = true
            texts.HealthText.Outline = true
            texts.HealthText.Font = 2
            texts.HealthText.Size = 12
        end
        texts.HealthText.Position = Vector2.new(arrowData.hrpPos.X, headPos.Y - 15 - yOffset)
        texts.HealthText.Text = "❤️ " .. math.floor(hum.Health)
        texts.HealthText.Color = Color3.fromRGB(255,100,100)
        texts.HealthText.Visible = true
        yOffset = yOffset + 16
    elseif texts.HealthText then texts.HealthText.Visible = false end

    if ESP.ShowDistance then
        if not texts.DistText then
            texts.DistText = getFromPool(drawingPool.texts, "Text")
            texts.DistText.Center = true
            texts.DistText.Outline = true
            texts.DistText.Font = 2
            texts.DistText.Size = 12
        end
        texts.DistText.Position = Vector2.new(arrowData.hrpPos.X, headPos.Y - 15 - yOffset)
        texts.DistText.Text = math.floor(arrowData.distance) .. " studs"
        texts.DistText.Color = Color3.fromRGB(200,200,200)
        texts.DistText.Visible = true
    elseif texts.DistText then texts.DistText.Visible = false end
end

local function drawTracer(plrData, parts, arrowData)
    if not ESP.ShowTracer then return end
    if arrowData.distance > ESP.MaxDistance or arrowData.distance < ESP.MinDistance or not arrowData.onScreen then
        if plrData.tracer then plrData.tracer.Visible = false end
        return
    end
    if not plrData.tracer then
        plrData.tracer = getFromPool(drawingPool.tracers, "Line")
        plrData.tracer.Thickness = ESP.TracerThickness
    end
    local screenCenter = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
    local footPos = Vector2.new(arrowData.hrpPos.X, arrowData.hrpPos.Y + 30)
    plrData.tracer.From = screenCenter
    plrData.tracer.To = footPos
    plrData.tracer.Color = arrowData.priority and ESP.PriorityColor or ESP.TracerColor
    plrData.tracer.Visible = true
end

local function drawArrow(plrData, arrowData)
    if not ESP.OffscreenArrows then
        if plrData.arrow then for _, a in pairs(plrData.arrow) do a.Visible = false end end
        return
    end
    if arrowData.onScreen then
        if plrData.arrow then for _, a in pairs(plrData.arrow) do a.Visible = false end end
        return
    end
    local hrp = arrowData.parts and arrowData.parts.HumanoidRootPart
    if not hrp then return end
    local camCF = Camera.CFrame
    local dir3 = (hrp.Position - camCF.Position).Unit
    local dir2 = Vector2.new(camCF.RightVector:Dot(dir3), -camCF.UpVector:Dot(dir3))
    if dir2.Magnitude < 0.001 then return end
    local dir = dir2.Unit
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local radius = math.min(Camera.ViewportSize.X, Camera.ViewportSize.Y) * 0.4
    local arrowPos = center + dir * radius
    arrowPos = Vector2.new(math.clamp(arrowPos.X, ESP.ArrowSize, Camera.ViewportSize.X - ESP.ArrowSize),
                           math.clamp(arrowPos.Y, ESP.ArrowSize, Camera.ViewportSize.Y - ESP.ArrowSize))
    if not plrData.arrow then
        plrData.arrow = { getFromPool(drawingPool.arrows,"Line"), getFromPool(drawingPool.arrows,"Line"), getFromPool(drawingPool.arrows,"Line") }
        for _, a in pairs(plrData.arrow) do a.Thickness = 2 end
    end
    local len = ESP.ArrowSize
    local tip = arrowPos + dir * len
    local perp = Vector2.new(-dir.Y, dir.X) * (len * 0.4)
    local color = arrowData.priority and ESP.PriorityColor or ESP.ArrowColor
    plrData.arrow[1].From = tip; plrData.arrow[1].To = arrowPos - dir * len
    plrData.arrow[2].From = tip; plrData.arrow[2].To = arrowPos + perp - dir * (len * 0.5)
    plrData.arrow[3].From = tip; plrData.arrow[3].To = arrowPos - perp - dir * (len * 0.5)
    for _, a in pairs(plrData.arrow) do a.Color = color; a.Visible = true end
end

local function draw2DBox(plrData, parts, arrowData)
    if arrowData.distance > ESP.MaxDistance or arrowData.distance < ESP.MinDistance or not arrowData.onScreen then
        if plrData.drawings and plrData.drawings.lines then
            for _, line in pairs(plrData.drawings.lines) do line.Visible = false end
        end
        return
    end
    local head = parts.Head
    local hrp = parts.HumanoidRootPart
    if not head or not hrp then return end
    local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0,0.5,0))
    local legPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0,3,0))
    local height = math.abs(headPos.Y - legPos.Y)
    if height < 2 then return end
    local width = height * 0.8
    local left = arrowData.hrpPos.X - width/2
    local top = headPos.Y
    local right = left + width
    local bottom = top + height
    local color = getBoxColor(parts._player, arrowData.visible, arrowData.priority)
    if not plrData.drawings then plrData.drawings = {} end
    local lines = plrData.drawings.lines
    if not lines then
        lines = {}
        for i=1,4 do lines[i] = getFromPool(drawingPool.lines, "Line") end
        plrData.drawings.lines = lines
    end
    lines[1].From = Vector2.new(left, top); lines[1].To = Vector2.new(right, top)
    lines[2].From = Vector2.new(right, top); lines[2].To = Vector2.new(right, bottom)
    lines[3].From = Vector2.new(right, bottom); lines[3].To = Vector2.new(left, bottom)
    lines[4].From = Vector2.new(left, bottom); lines[4].To = Vector2.new(left, top)
    for i=1,4 do
        lines[i].Color = color
        lines[i].Thickness = arrowData.priority and ESP.BoxThickness+2 or ESP.BoxThickness
        lines[i].Visible = true
    end
end

local function drawChams(plrData, visible, priority)
    if not ESP.Chams then
        if plrData.highlight then plrData.highlight.Enabled = false end
        return
    end
    if not plrData.highlight then return end
    plrData.highlight.FillColor = priority and ESP.PriorityColor or (visible and ESP.ChamsVisibleColor or ESP.ChamsOccludedColor)
    plrData.highlight.FillTransparency = ESP.ChamsTransparency
    plrData.highlight.Enabled = true
end

-- ===== ОСНОВНОЙ РЕНДЕР =====
local function updateESP()
    if isUnloaded or not ESP.Enabled then
        for _, data in pairs(playersData) do hideAll(data) end
        return
    end

    for plr, data in pairs(playersData) do
        local parts = data.parts
        local hrp = parts and parts.HumanoidRootPart
        local head = parts and parts.Head
        local hum = parts and parts.humanoid
        if hrp and head and hum and hum.Health > 0 and parts.Character.Parent then
            if ESP.HideTeammates and isTeammate(plr) then
                hideAll(data)
                goto continue
            end
            local hrpPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            if not onScreen then
                hideAll(data)
                goto continue
            end
            local distance = (Camera.CFrame.Position - hrp.Position).Magnitude
            if distance > ESP.MaxDistance or distance < ESP.MinDistance then
                hideAll(data)
                goto continue
            end
            local visible = false
            if ESP.VisibleCheck then visible = isVisibleCached(data, head) end
            local rd = { player = plr, hrpPos = hrpPos, onScreen = onScreen, distance = distance, visible = visible, priority = false, parts = parts }
            if ESP.PriorityTarget then
                -- упрощённо: можно вычислить приоритет здесь или в отдельном цикле
                -- для краткости оставим как есть, но можно доработать
                rd.priority = renderData[plr] and renderData[plr].priority or false
            end
            if ESP.BoxType == "2D" then
                draw2DBox(data, parts, rd)
                if data.drawings and data.drawings.corners then for _,c in pairs(data.drawings.corners) do c.Visible = false end end
            elseif ESP.BoxType == "Corner" then
                drawCornerBox(data, parts, hrpPos, distance, visible, rd.priority)
                if data.drawings and data.drawings.lines then for _,l in pairs(data.drawings.lines) do l.Visible = false end end
            elseif ESP.BoxType == "3D" then
                draw3DBox(data, parts, visible, rd.priority)
                if data.drawings then
                    if data.drawings.lines then for _,l in pairs(data.drawings.lines) do l.Visible = false end end
                    if data.drawings.corners then for _,c in pairs(data.drawings.corners) do c.Visible = false end end
                end
            end
            drawSkeleton(data, parts, rd)
            drawTexts(data, parts, rd)
            drawTracer(data, parts, rd)
            drawArrow(data, rd)
            drawChams(data, visible, rd.priority)
        else
            hideAll(data)
        end
        ::continue::
    end
end

-- ===== FPS СЧЁТЧИК =====
local function createFPSDisplay()
    if fpsLabel then return end
    local gui = Instance.new("ScreenGui")
    gui.Name = "FPSDisplay"
    gui.ResetOnSpawn = false
    gui.Parent = LP:WaitForChild("PlayerGui")
    fpsLabel = Instance.new("TextLabel", gui)
    fpsLabel.Size = UDim2.new(0,100,0,20)
    fpsLabel.Position = UDim2.new(1,-110,0,10)
    fpsLabel.BackgroundTransparency = 1
    fpsLabel.TextColor3 = Color3.fromRGB(255,255,255)
    fpsLabel.TextStrokeTransparency = 0.5
    fpsLabel.Font = Enum.Font.SourceSansBold
    fpsLabel.TextSize = 12
    drawCountLabel = Instance.new("TextLabel", gui)
    drawCountLabel.Size = UDim2.new(0,100,0,20)
    drawCountLabel.Position = UDim2.new(1,-110,0,30)
    drawCountLabel.BackgroundTransparency = 1
    drawCountLabel.TextColor3 = Color3.fromRGB(200,200,200)
    drawCountLabel.Font = Enum.Font.SourceSans
    drawCountLabel.TextSize = 10
end

local function updateFPSDisplay()
    if not ESP.ShowFPS then
        if fpsLabel then fpsLabel.Visible = false end
        if drawCountLabel then drawCountLabel.Visible = false end
        return
    end
    if not fpsLabel then createFPSDisplay() end
    fpsLabel.Visible = true
    drawCountLabel.Visible = true
    local totalDrawings = 0
    for _, pool in pairs(drawingPool) do totalDrawings = totalDrawings + #pool end
    fpsLabel.Text = string.format("FPS: %d", currentFPS)
    drawCountLabel.Text = string.format("Draw: %d", totalDrawings)
end

-- ===== КАМЕРНЫЙ АИМБОТ И FOV =====
local function isAimbotKeyPressed()
    local key = ESP.AimbotKey
    if not key then return false end
    if key.EnumType == Enum.UserInputType then
        return UIS:IsMouseButtonPressed(key)
    elseif key.EnumType == Enum.KeyCode then
        return UIS:IsKeyDown(key)
    end
    return false
end

local function updateAimbotLoop()
    if isUnloaded then return end
    if fovCircle then
        fovCircle.Position = UIS:GetMouseLocation()
        fovCircle.Radius = ESP.FOVRadius
        fovCircle.Color = ESP.FOVColor
        fovCircle.Thickness = ESP.FOVThickness
        fovCircle.Filled = ESP.FilledFOV
        fovCircle.Transparency = ESP.FOVTransparency
        fovCircle.Visible = ESP.ShowFOV and (ESP.CameraEnabled or ESP.SilentEnabled)
    end
    if ESP.CameraEnabled and not UIS:GetFocusedTextBox() then
        if isAimbotKeyPressed() then
            local targetPart = getClosestPlayerToCursor()
            if targetPart then
                local lookAt = CFrame.new(Camera.CFrame.Position, targetPart.Position)
                Camera.CFrame = Camera.CFrame:Lerp(lookAt, ESP.Smoothness)
            end
        end
    end
end

-- ===== ЦИКЛЫ =====
local function onHeartbeat()
    if isUnloaded then return end
    local now = os.clock()
    if now - lastHeartbeat >= heartbeatInterval then
        lastHeartbeat = now
        -- Здесь можно обновлять приоритет целей, но для простоты оставим
    end
end

local function onRender(dt)
    if isUnloaded then return end
    fpsIndex = fpsIndex % 30 + 1
    fpsRing[fpsIndex] = tick()
    if fpsIndex == 30 then
        local oldest = fpsRing[1]
        if oldest then currentFPS = math.floor(30 / (tick() - oldest)) end
    end
    if ESP.ShowFPS then updateFPSDisplay() end
    updateAimbotLoop()
    updateESP()
end

-- ===== ИНИЦИАЛИЗАЦИЯ И ВЫГРУЗКА =====
local function initESP()
    for _, player in ipairs(Players:GetPlayers()) do setupPlayer(player) end
    playerAddedConn = Players.PlayerAdded:Connect(setupPlayer)
    playerRemovingConn = Players.PlayerRemoving:Connect(function(player)
        if playersData[player] then destroyAll(playersData[player]); playersData[player] = nil end
        if connections[player] then
            for _, conn in pairs(connections[player]) do if conn then conn:Disconnect() end end
            connections[player] = nil
        end
        renderData[player] = nil
    end)
end

local function unloadHub()
    if isUnloaded then return end
    isUnloaded = true
    if playerAddedConn then playerAddedConn:Disconnect() end
    if playerRemovingConn then playerRemovingConn:Disconnect() end
    if renderSteppedConn then renderSteppedConn:Disconnect() end
    if heartbeatConn then heartbeatConn:Disconnect() end
    if hotkeyConn then hotkeyConn:Disconnect() end
    for plr, userConns in pairs(connections) do
        for _, conn in pairs(userConns) do if conn then conn:Disconnect() end end
    end
    table.clear(connections)
    for plr, data in pairs(playersData) do destroyAll(data) end
    table.clear(playersData)
    table.clear(renderData)
    for _, pool in pairs(drawingPool) do
        for _, obj in ipairs(pool) do safeDestroy(obj) end
        table.clear(pool)
    end
    if fovCircle then fovCircle:Remove() end
    if fpsLabel then fpsLabel.Visible = false end
    if drawCountLabel then drawCountLabel.Visible = false end
    local gmt = getrawmetatable(game)
    if gmt and oldNamecall and oldIndex then
        setreadonly(gmt, false)
        gmt.__namecall = oldNamecall
        gmt.__index = oldIndex
        setreadonly(gmt, true)
    end
    Library:Unload()
end

-- ===== ГОРЯЧИЕ КЛАВИШИ =====
local function setupHotkeys()
    hotkeyConn = UIS.InputBegan:Connect(function(input,gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.F1 then
            ESP.Enabled = not ESP.Enabled
            if Options.ESPEnabled then Options.ESPEnabled:SetValue(ESP.Enabled) end
            print("ESP toggled:", ESP.Enabled)
        elseif input.KeyCode == Enum.KeyCode.F2 then
            local types = {"2D","3D","Corner"}
            local idx = table.find(types, ESP.BoxType) or 1
            idx = idx % 3 + 1
            ESP.BoxType = types[idx]
            if Options.BoxType then Options.BoxType:SetValue(ESP.BoxType) end
            print("Box type changed to:", ESP.BoxType)
        elseif input.KeyCode == Enum.KeyCode.F3 then
            ESP.Skeleton = not ESP.Skeleton
            if Options.SkeletonEnabled then Options.SkeletonEnabled:SetValue(ESP.Skeleton) end
            print("Skeleton toggled:", ESP.Skeleton)
        end
    end)
end

