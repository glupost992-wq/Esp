mainRight:AddColorPicker("OccludedColor", { Text = "Occluded Box Color", Default = Color3.fromRGB(255,200,0), Callback = function(c) ESP.OccludedColor = c end })
mainRight:AddToggle("PriorityTarget", { Text = "Smart Priority", Default = true, Callback = function(v) ESP.PriorityTarget = v end })
mainRight:AddColorPicker("PriorityColor", { Text = "Priority Color", Default = Color3.fromRGB(255,215,0), Callback = function(c) ESP.PriorityColor = c end })

local visualLeft = Tabs.Visuals:AddLeftGroupbox("Skeleton & Tracers")
visualLeft:AddToggle("SkeletonEnabled", { Text = "Show Skeleton", Default = false, Callback = function(v) ESP.Skeleton = v end })
visualLeft:AddColorPicker("SkeletonColor", { Text = "Skeleton Color", Default = Color3.fromRGB(255,0,0), Callback = function(c) ESP.SkeletonColor = c end })
visualLeft:AddSlider("SkeletonThickness", { Text = "Skeleton Thickness", Default = 2, Min = 1, Max = 5, Rounding = 0, Callback = function(v) ESP.SkeletonThickness = v end })
visualLeft:AddToggle("ShowTracer", { Text = "Show Tracer", Default = false, Callback = function(v) ESP.ShowTracer = v end })
visualLeft:AddColorPicker("TracerColor", { Text = "Tracer Color", Default = Color3.fromRGB(255,255,255), Callback = function(c) ESP.TracerColor = c end })
visualLeft:AddSlider("TracerThickness", { Text = "Tracer Thickness", Default = 1, Min = 1, Max = 4, Rounding = 0, Callback = function(v) ESP.TracerThickness = v end })

local visualRight = Tabs.Visuals:AddRightGroupbox("Chams & Text")
visualRight:AddToggle("Chams", { Text = "Enable Chams", Default = false, Callback = function(v)
    ESP.Chams = v
    for plr, data in pairs(playersData) do
        local char = plr.Character
        if v then
            if char then
                if not data.highlight or data.highlight.Parent ~= char then
                    if data.highlight then data.highlight:Destroy() end
                    local hl = Instance.new("Highlight")
                    hl.Parent = char
                    hl.FillColor = ESP.ChamsVisibleColor
                    hl.FillTransparency = ESP.ChamsTransparency
                    hl.OutlineTransparency = 1
                    hl.Enabled = true
                    data.highlight = hl
                end
            end
        else
            if data.highlight then
                data.highlight.Enabled = false
            end
        end
    end
end })
visualRight:AddColorPicker("ChamsVisibleColor", { Text = "Visible Chams Color", Default = Color3.fromRGB(0,255,0), Callback = function(c) ESP.ChamsVisibleColor = c end })
visualRight:AddColorPicker("ChamsOccludedColor", { Text = "Occluded Chams Color", Default = Color3.fromRGB(255,0,0), Callback = function(c) ESP.ChamsOccludedColor = c end })
visualRight:AddSlider("ChamsTransparency", { Text = "Chams Transparency", Default = 0.5, Min = 0, Max = 1, Rounding = 0.05, Callback = function(v) ESP.ChamsTransparency = v end })
visualRight:AddToggle("ShowName", { Text = "Show Name", Default = true, Callback = function(v) ESP.ShowName = v end })
visualRight:AddToggle("ShowHealth", { Text = "Show Health", Default = true, Callback = function(v) ESP.ShowHealth = v end })
visualRight:AddToggle("ShowDistance", { Text = "Show Distance", Default = true, Callback = function(v) ESP.ShowDistance = v end })

local uiGroup = Tabs["UI Settings"]:AddLeftGroupbox("Menu")
uiGroup:AddKeyPicker("MenuKeybind", { Default = "RightShift", NoUI = true, Text = "Menu keybind" })
