-- ===== ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ESP =====
local function safeDestroy(obj) if obj then pcall(function() if typeof(obj)=="Instance" then obj:Destroy() else if obj.Remove then obj:Remove() else obj.Visible=false end end end) end end
local function removeFromPool(pool, obj) for i,v in ipairs(pool) do if v==obj then table.remove(pool,i) break end end end
local function getFromPool(pool, type) for i,obj in ipairs(pool) do if obj and obj.Visible==false then return obj end end local new=Drawing.new(type) table.insert(pool,new) return new end
local function hideAll(d) if d.drawings then for _,g in pairs(d.drawings) do if type(g)=="table" then for _,o in pairs(g) do o.Visible=false end elseif g then g.Visible=false end end end if d.skeletonLines then for _,l in pairs(d.skeletonLines) do l.Visible=false end end if d.texts then for _,t in pairs(d.texts) do t.Visible=false end end if d.tracer then d.tracer.Visible=false end if d.adornment then d.adornment.Visible=false end if d.arrow then for _,a in pairs(d.arrow) do a.Visible=false end end if d.highlight then d.highlight.Enabled=false end end
local function destroyAll(d) if not d then return end if d.drawings then for _,g in pairs(d.drawings) do if type(g)=="table" then for _,o in pairs(g) do safeDestroy(o); removeFromPool(drawingPool.lines,o); removeFromPool(drawingPool.corners,o) end else safeDestroy(g); removeFromPool(drawingPool.lines,g) end end d.drawings=nil end if d.skeletonLines then for _,l in pairs(d.skeletonLines) do safeDestroy(l); removeFromPool(drawingPool.skeleton,l) end d.skeletonLines=nil end if d.texts then for _,t in pairs(d.texts) do safeDestroy(t); removeFromPool(drawingPool.texts,t) end d.texts=nil end if d.tracer then safeDestroy(d.tracer); removeFromPool(drawingPool.tracers,d.tracer); d.tracer=nil end if d.adornment then safeDestroy(d.adornment); d.adornment=nil end if d.arrow then for _,a in pairs(d.arrow) do safeDestroy(a); removeFromPool(drawingPool.arrows,a) end d.arrow=nil end if d.highlight then safeDestroy(d.highlight); d.highlight=nil end end

local function isTeammate(plr) return LP.Team and plr.Team and LP.Team==plr.Team end

local function cachePlayerParts(plr, char)
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local parts = {
        _player = plr,
        Character = char,
        humanoid = hum,
        Head = char:FindFirstChild("Head"),
        Torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"),
        HumanoidRootPart = char:FindFirstChild("HumanoidRootPart"),
    }
    parts.LeftArm = char:FindFirstChild("LeftArm") or char:FindFirstChild("LeftUpperArm")
    parts.LeftLowerArm = char:FindFirstChild("LeftLowerArm")
    parts.LeftHand = char:FindFirstChild("LeftHand")
    parts.RightArm = char:FindFirstChild("RightArm") or char:FindFirstChild("RightUpperArm")
    parts.RightLowerArm = char:FindFirstChild("RightLowerArm")
    parts.RightHand = char:FindFirstChild("RightHand")
    parts.LeftLeg = char:FindFirstChild("LeftLeg") or char:FindFirstChild("LeftUpperLeg")
    parts.LeftLowerLeg = char:FindFirstChild("LeftLowerLeg")
    parts.LeftFoot = char:FindFirstChild("LeftFoot")
    parts.RightLeg = char:FindFirstChild("RightLeg") or char:FindFirstChild("RightUpperLeg")
    parts.RightLowerLeg = char:FindFirstChild("RightLowerLeg")
    parts.RightFoot = char:FindFirstChild("RightFoot")
    playersData[plr] = {parts = parts}
end

local function setupPlayer(plr) 
    if plr==LP then return end 
    if playersData[plr] then hideAll(playersData[plr]) end 
    if connections[plr] then for _,c in pairs(connections[plr]) do if c then c:Disconnect() end end end 
    playersData[plr]={parts={}, drawings=nil, skeletonLines=nil, texts=nil, tracer=nil, adornment=nil, arrow=nil, highlight=nil, visible=false, lastVisibleUpdate=0} 
    renderData[plr]=nil 
    connections[plr]={}
    
    local ca=plr.CharacterAdded:Connect(function(char) 
        task.spawn(function() 
            if LP.Character then rayParams.FilterDescendantsInstances={LP.Character, Camera} end 
            local hrp=char:WaitForChild("HumanoidRootPart",5) 
            local head=char:WaitForChild("Head",5) 
            if hrp and head and char.Parent then 
                cachePlayerParts(plr,char) 
                local d=playersData[plr] 
                if d then 
                    if d.highlight then safeDestroy(d.highlight); d.highlight=nil end 
                    if Config.ESP.Chams then 
                        local hl=Instance.new("Highlight") 
                        hl.Name="GlupostESPHighlight" 
                        hl.FillColor=Config.ESP.ChamsVisibleColor 
                        hl.OutlineColor=Config.ESP.ChamsOccludedColor 
                        hl.FillTransparency=Config.ESP.ChamsTransparency 
                        hl.Parent=char 
                        d.highlight=hl 
                    end 
                end 
            end 
        end) 
    end)
    
    local cr=plr.CharacterRemoving:Connect(function()
        if playersData[plr] then 
            if playersData[plr].highlight then
                safeDestroy(playersData[plr].highlight)
                playersData[plr].highlight = nil
            end
            hideAll(playersData[plr]) 
        end
        predictionCache[plr] = nil
        threatScoreCache[plr] = nil
    end)
    
    connections[plr].CharacterAdded=ca 
    connections[plr].CharacterRemoving=cr
    if plr.Character then cachePlayerParts(plr, plr.Character) end
end

local function getBoxColor(plr,visible,priority) if priority then return Config.ESP.PriorityColor end if Config.ESP.VisibleCheck then return visible and Config.ESP.VisibleColor or Config.ESP.OccludedColor else if Config.ESP.HideTeammates and isTeammate(plr) then return Config.ESP.AllyColor else return Config.ESP.EnemyColor end end end
local function isVisibleCached(data,part) local now=os.clock() if now-data.lastVisibleUpdate<CONST.VISIBLE_UPDATE_INTERVAL then return data.visible end data.lastVisibleUpdate=now if not part then data.visible=false return false end local origin=Camera.CFrame.Position local delta=part.Position-origin local mag=delta.Magnitude if mag<0.001 then data.visible=true return true end local dir=delta/mag if LP.Character then rayParams.FilterDescendantsInstances={LP.Character, Camera} else rayParams.FilterDescendantsInstances={Camera} end local res=workspace:Raycast(origin,dir*mag,rayParams) if not res then data.visible=true return true end data.visible=(res.Position-origin).Magnitude>=mag-0.5 return data.visible end

-- ===== ESP ОТРИСОВКА =====
local function updateBoxPosition(d, parts, rd)
    if rd.distance>Config.ESP.MaxDistance or rd.distance<Config.ESP.MinDistance or not rd.onScreen then
        if d.drawings then
            if d.drawings.lines then for _,l in pairs(d.drawings.lines) do l.Visible=false end end
            if d.drawings.corners then for _,c in pairs(d.drawings.corners) do c.Visible=false end end
        end
        return false
    end
    local head=parts.Head local hrp=parts.HumanoidRootPart
    if not head or not hrp then return false end
    local headPos=Camera:WorldToViewportPoint(head.Position+Vector3.new(0,0.5,0))
    local legPos=Camera:WorldToViewportPoint(hrp.Position-Vector3.new(0,3,0))
    local height=math.abs(headPos.Y-legPos.Y) if height<2 then return false end
    local width=height*0.8
    local left=rd.hrpPos.X-width/2 local top=headPos.Y
    local right=left+width local bottom=top+height
    local color=getBoxColor(parts._player,rd.visible,rd.priority)
    if Config.ESP.BoxType=="2D" then
        if not d.drawings then d.drawings={} end
        local lines=d.drawings.lines
        if not lines then lines={} for i=1,4 do lines[i]=getFromPool(drawingPool.lines,"Line") end d.drawings.lines=lines end
        lines[1].From=Vector2.new(left,top); lines[1].To=Vector2.new(right,top)
        lines[2].From=Vector2.new(right,top); lines[2].To=Vector2.new(right,bottom)
        lines[3].From=Vector2.new(right,bottom); lines[3].To=Vector2.new(left,bottom)
        lines[4].From=Vector2.new(left,bottom); lines[4].To=Vector2.new(left,top)
        for i=1,4 do lines[i].Color=color; lines[i].Thickness=rd.priority and Config.ESP.BoxThickness+2 or Config.ESP.BoxThickness; lines[i].Visible=true end
        if d.drawings.corners then for _,c in pairs(d.drawings.corners) do c.Visible=false end end
    elseif Config.ESP.BoxType=="Corner" then
        if not d.drawings then d.drawings={} end
        local corners=d.drawings.corners
        if not corners then corners={} for i=1,8 do corners[i]=getFromPool(drawingPool.corners,"Line") end d.drawings.corners=corners end
        local len=12
        corners[1].From=Vector2.new(left,top); corners[1].To=Vector2.new(left+len,top)
        corners[2].From=Vector2.new(left,top); corners[2].To=Vector2.new(left,top+len)
        corners[3].From=Vector2.new(right,top); corners[3].To=Vector2.new(right-len,top)
        corners[4].From=Vector2.new(right,top); corners[4].To=Vector2.new(right,top+len)
        corners[5].From=Vector2.new(left,bottom); corners[5].To=Vector2.new(left+len,bottom)
        corners[6].From=Vector2.new(left,bottom); corners[6].To=Vector2.new(left,bottom-len)
        corners[7].From=Vector2.new(right,bottom); corners[7].To=Vector2.new(right-len,bottom)
        corners[8].From=Vector2.new(right,bottom); corners[8].To=Vector2.new(right,bottom-len)
        for i=1,8 do corners[i].Color=color; corners[i].Thickness=rd.priority and Config.ESP.BoxThickness+2 or Config.ESP.BoxThickness; corners[i].Visible=true end
        if d.drawings.lines then for _,l in pairs(d.drawings.lines) do l.Visible=false end end
    elseif Config.ESP.BoxType=="3D" then
        if d.drawings then
            if d.drawings.lines then for _,l in pairs(d.drawings.lines) do l.Visible=false end end
            if d.drawings.corners then for _,c in pairs(d.drawings.corners) do c.Visible=false end end
        end
        if not Config.ESP.Chams then
            if not d.adornment then
                d.adornment=Instance.new("BoxHandleAdornment")
                d.adornment.AlwaysOnTop=true
                d.adornment.Transparency=0.5
                d.adornment.ZIndex=0
                d.adornment.Parent=hrp
            end
            d.adornment.Adornee=hrp
            d.adornment.Size=hrp.Size+Vector3.new(2,3,2)
            d.adornment.Color=color
            d.adornment.Visible=true
        end
    end
    return true
end

local function updateSkeletonOptimized(d, parts, rd)
    if not Config.ESP.Skeleton then return end
    local plr=parts._player
    if plr and plr.Character and (not parts.LeftLowerArm or not parts.RightLowerArm or not parts.LeftLowerLeg or not parts.RightLowerLeg) then
        cachePlayerParts(plr,plr.Character)
        parts=playersData[plr].parts
        if not parts then return end
    end
    local function getPos(part) if part then local pos,on=Camera:WorldToViewportPoint(part.Position) if on then return pos end end return nil end
    local conns={
        {parts.Head,parts.Torso},
        {parts.Torso,parts.HumanoidRootPart},
        {parts.Torso,parts.LeftArm},
        {parts.Torso,parts.RightArm},
        {parts.LeftArm,parts.LeftLowerArm},
        {parts.RightArm,parts.RightLowerArm},
        {parts.LeftLowerArm,parts.LeftHand},
        {parts.RightLowerArm,parts.RightHand},
        {parts.Torso,parts.LeftLeg},
        {parts.Torso,parts.RightLeg},
        {parts.LeftLeg,parts.LeftLowerLeg},
        {parts.RightLeg,parts.RightLowerLeg},
        {parts.LeftLowerLeg,parts.LeftFoot},
        {parts.RightLowerLeg,parts.RightFoot},
    }
    if not d.skeletonLines then d.skeletonLines={} for i=1,#conns do d.skeletonLines[i]=getFromPool(drawingPool.skeleton,"Line") end end
    local idx=1
    local color=rd.priority and Config.ESP.PriorityColor or Config.ESP.SkeletonColor
    for _,c in ipairs(conns) do
        local a=getPos(c[1]) local b=getPos(c[2])
        if a and b then
            d.skeletonLines[idx].From=Vector2.new(a.X,a.Y)
            d.skeletonLines[idx].To=Vector2.new(b.X,b.Y)
            d.skeletonLines[idx].Color=color
            d.skeletonLines[idx].Thickness=Config.ESP.SkeletonThickness
            d.skeletonLines[idx].Visible=true
        else
            d.skeletonLines[idx].Visible=false
        end
        idx=idx+1
    end
    for i=idx,#d.skeletonLines do if d.skeletonLines[i] then d.skeletonLines[i].Visible=false end end
end

local function updateTextOptimized(d, parts, rd)
    if not Config.ESP.ShowName and not Config.ESP.ShowHealth and not Config.ESP.ShowDistance then return end
    if rd.distance>Config.ESP.MaxDistance or rd.distance<Config.ESP.MinDistance or not rd.onScreen then
        if d.texts then for _,t in pairs(d.texts) do t.Visible=false end end
        return
    end
    local head=parts.Head if not head then return end
    local headPos=Camera:WorldToViewportPoint(head.Position+Vector3.new(0,0.5,0))
    local hum=parts.humanoid if not hum or hum.Health<=0 then return end
    if not d.texts then d.texts={} end
    local texts=d.texts local yOff=0
    if Config.ESP.ShowName then
        if not texts.NameText then
            texts.NameText=getFromPool(drawingPool.texts,"Text")
            texts.NameText.Center=true texts.NameText.Outline=true texts.NameText.Font=2 texts.NameText.Size=14
        end
        texts.NameText.Position=Vector2.new(rd.hrpPos.X,headPos.Y-15-yOff)
        texts.NameText.Text=parts._player.DisplayName
        texts.NameText.Color=rd.priority and Config.ESP.PriorityColor or getBoxColor(parts._player,rd.visible,false)
        texts.NameText.Visible=true
        yOff=yOff+16
    elseif texts.NameText then texts.NameText.Visible=false end
    if Config.ESP.ShowHealth then
        if not texts.HealthText then
            texts.HealthText=getFromPool(drawingPool.texts,"Text")
            texts.HealthText.Center=true texts.HealthText.Outline=true texts.HealthText.Font=2 texts.HealthText.Size=12
        end
        texts.HealthText.Position=Vector2.new(rd.hrpPos.X,headPos.Y-15-yOff)
        texts.HealthText.Text="HP "..math.floor(hum.Health)
        texts.HealthText.Color=Color3.fromRGB(255,100,100)
        texts.HealthText.Visible=true
        yOff=yOff+16
    elseif texts.HealthText then texts.HealthText.Visible=false end
    if Config.ESP.ShowDistance then
        if not texts.DistText then
            texts.DistText=getFromPool(drawingPool.texts,"Text")
            texts.DistText.Center=true texts.DistText.Outline=true texts.DistText.Font=2 texts.DistText.Size=12
        end
        texts.DistText.Position=Vector2.new(rd.hrpPos.X,headPos.Y-15-yOff)
        texts.DistText.Text=math.floor(rd.distance).." studs"
        texts.DistText.Color=Color3.fromRGB(200,200,200)
        texts.DistText.Visible=true
    elseif texts.DistText then texts.DistText.Visible=false end
end

local function updateArrowOptimized(d, rd)
    if not Config.ESP.OffscreenArrows then
        if d.arrow then for _,a in pairs(d.arrow) do a.Visible=false end end
        return
    end
    if rd.onScreen then
        if d.arrow then for _,a in pairs(d.arrow) do a.Visible=false end end
        return
    end
    local hrp=rd.parts and rd.parts.HumanoidRootPart if not hrp then return end
    local camCF=Camera.CFrame
    local dir3=(hrp.Position-camCF.Position).Unit
    local dir2=Vector2.new(camCF.RightVector:Dot(dir3), -camCF.UpVector:Dot(dir3))
    if dir2.Magnitude<0.001 then return end
    local dir=dir2.Unit
    local center=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y/2)
    local radius=math.min(Camera.ViewportSize.X,Camera.ViewportSize.Y)*0.4
    local arrowPos=center+dir*radius
    arrowPos=Vector2.new(math.clamp(arrowPos.X,Config.ESP.ArrowSize,Camera.ViewportSize.X-Config.ESP.ArrowSize),
        math.clamp(arrowPos.Y,Config.ESP.ArrowSize,Camera.ViewportSize.Y-Config.ESP.ArrowSize))
    if not d.arrow then
        d.arrow={ getFromPool(drawingPool.arrows,"Line"), getFromPool(drawingPool.arrows,"Line"), getFromPool(drawingPool.arrows,"Line") }
        for _,a in pairs(d.arrow) do a.Thickness=2 end
    end
    local len=Config.ESP.ArrowSize
    local tip=arrowPos+dir*len
    local perp=Vector2.new(-dir.Y,dir.X)*(len*0.4)
    local color=rd.priority and Config.ESP.PriorityColor or Config.ESP.ArrowColor
    d.arrow[1].From=tip; d.arrow[1].To=arrowPos-dir*len
    d.arrow[2].From=tip; d.arrow[2].To=arrowPos+perp-dir*(len*0.5)
    d.arrow[3].From=tip; d.arrow[3].To=arrowPos-perp-dir*(len*0.5)
    for _,a in pairs(d.arrow) do a.Color=color; a.Visible=true end
end

-- ===== УЛУЧШЕННЫЙ THREAT SCORE =====
local function isVisibleThreat(head)
    if not head then return false end
    local origin = Camera.CFrame.Position
    local dir = head.Position - origin
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = { LP.Character }
    local result = workspace:Raycast(origin, dir, rayParams)
    if not result then return true end
    return result.Instance:IsDescendantOf(head.Parent)
end

local function calculateThreatScore(plr, parts)
    local myChar = LP.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myPos = myRoot and myRoot.Position or Camera.CFrame.Position

    local targetHead = parts.Head
    if not targetHead then return -1000 end
    local targetRoot = parts.HumanoidRootPart
    local targetHum = parts.humanoid
    if not targetRoot or not targetHum or targetHum.Health <= 0 then return -1000 end

    local dist = (myPos - targetRoot.Position).Magnitude

    local visible = isVisibleThreat(targetHead)
    local visNorm = visible and 1 or 0

    local lookNorm = 0
    if targetHead and myRoot then
        local lookVector = targetHead.CFrame.LookVector
        local toMe = (myRoot.Position - targetHead.Position).Unit
        local dot = lookVector:Dot(toMe)
        lookNorm = (dot + 1) / 2
    end

    local maxDist = Config.ESP.MaxDistance
    local distNorm = 1 - math.clamp(dist / maxDist, 0, 1)

    local health = targetHum.Health
    local maxHealth = targetHum.MaxHealth
    if maxHealth <= 0 then maxHealth = 100 end
    local healthNorm = 1 - health / maxHealth

    local weights = Config.ThreatWeights
    local score = visNorm * weights.Visibility + lookNorm * weights.LookAtMe + distNorm * weights.Distance + healthNorm * weights.Health
    threatScoreCache[plr] = score
    return score
end

-- ===== PREDICTION =====
local function getPredictedPosition(targetPart)
    if not Config.Aimbot.Prediction then return targetPart.Position end
    local plr = targetPart.Parent and targetPart.Parent.Parent and Players:GetPlayerFromCharacter(targetPart.Parent)
    if not plr then return targetPart.Position end
    local pred = predictionCache[plr]
    if not pred or not pred.velocity then return targetPart.Position end
    local now = tick()
    local dt = now - pred.time
    if dt > 0.2 then return targetPart.Position end
    return targetPart.Position + pred.velocity * Config.Aimbot.PredictionFactor
end

-- ===== RCS ADAPTIVE =====
local function addRecoilPattern(toolName)
    if not recoilPatterns[toolName] then
        if #recoilPatternOrder >= CONST.MAX_RECOIL_PATTERNS then
            local oldest = table.remove(recoilPatternOrder, 1)
            recoilPatterns[oldest] = nil
        end
        recoilPatterns[toolName] = {}
        table.insert(recoilPatternOrder, toolName)
    else
        for i, v in ipairs(recoilPatternOrder) do
            if v == toolName then
                table.remove(recoilPatternOrder, i)
                table.insert(recoilPatternOrder, toolName)
                break
            end
        end
    end
end

local function recordRecoilStart()
    if not Config.Aimbot.RCSEnabled or not Config.Aimbot.RCSAdaptiveLearning then return end
    local tool = LP.Character and LP.Character:FindFirstChildOfClass("Tool")
    local toolName = tool and tool.Name or "Unknown"
    addRecoilPattern(toolName)
    currentRecoilPattern = recoilPatterns[toolName]
    recoilStep = 0
    lastShotTick = tick()
    currentRecoilPattern.startCFrame = Camera.CFrame
end

local function recordRecoilUpdate()
    if not currentRecoilPattern or not Config.Aimbot.RCSAdaptiveLearning then return end
    local now = tick()
    local dt = now - lastShotTick
    if dt > 0.3 then currentRecoilPattern = nil; return end
    if dt < 0.02 then return end

    local mouseDelta = UIS:GetMouseDelta()
    if mouseDelta.Magnitude > Config.Aimbot.MouseMoveThreshold then return end

    local startCF = currentRecoilPattern.startCFrame
    local currentCF = Camera.CFrame
    local delta = startCF:ToObjectSpace(currentCF)
    local rx, ry, rz = delta:ToEulerAnglesYXZ()
    local angle = math.deg(math.sqrt(rx*rx + ry*ry))
    if angle > CONST.RCS_MAX_STEP_ANGLE then return end
    local stepData = {dx = math.deg(rx), dy = math.deg(ry)}
    if recoilStep >= #currentRecoilPattern then
        table.insert(currentRecoilPattern, stepData)
    else
        local old = currentRecoilPattern[recoilStep+1]
        if old then
            old.dx = (old.dx + stepData.dx) / 2
            old.dy = (old.dy + stepData.dy) / 2
        end
    end
    recoilStep = recoilStep + 1
    lastShotTick = now
end

local applyAdaptiveRCS
applyAdaptiveRCS = function(targetPos)
    if not Config.Aimbot.RCSEnabled or not currentRecoilPattern or recoilStep == 0 then return targetPos end
    local totalDx, totalDy = 0, 0
    for i = 1, recoilStep do
        local step = currentRecoilPattern[i]
        if step then
            totalDx = totalDx + step.dx
            totalDy = totalDy + step.dy
        end
    end
    local cameraCF = Camera.CFrame
    local right = cameraCF.RightVector
    local up = cameraCF.UpVector
    local dist = (cameraCF.Position - targetPos).Magnitude
    local compensation = (right * totalDy + up * totalDx) * dist * 0.001 * Config.Aimbot.RCSStrength
    return targetPos - compensation
end

-- ===== СГЛАЖИВАНИЕ =====
local function applySmoothing(currentCF, targetCF, targetPart)
    local smoothType = Config.Aimbot.SmoothnessType
    if smoothType == "Instant" then return targetCF end

    if Config.Aimbot.Humanize and targetPart then
        local oscillation = Config.Aimbot.HumanizeOscillation
        local freq = Config.Aimbot.HumanizeFrequency
        local t = tick() * freq
        local noiseX = perlinNoise1D(t) * oscillation
        local noiseY = perlinNoise1D(t + 100) * oscillation
        local camRight = Camera.CFrame.RightVector
        local camUp = Camera.CFrame.UpVector
        local dist = (Camera.CFrame.Position - targetCF.Position).Magnitude
        local worldOffset = camRight * noiseX + camUp * noiseY
        local newLookAt = targetCF.Position + worldOffset * (dist / Camera.ViewportSize.X) * 2
        targetCF = CFrame.new(Camera.CFrame.Position, newLookAt)
    end

    local t = Config.Aimbot.Smoothness
    if smoothType == "Linear" then
        return currentCF:Lerp(targetCF, t)
    elseif smoothType == "Easing" then
        local eased = 1 - math.pow(1 - t, 3)
        return currentCF:Lerp(targetCF, eased)
    elseif smoothType == "HumanLike" then
        local factor = t * (0.7 + 0.3 * math.sin(tick() * 1.5))
        return currentCF:Lerp(targetCF, math.clamp(factor, 0.05, 0.8))
    end
    return targetCF
end

-- ===== SILENT AIM (Исправленный Namecall) =====
local gmt = getrawmetatable(game)
local oldNamecall, oldIndex
local ourSilentHook

local function initSilentAimbot()
    if not gmt then return end
    oldNamecall = gmt.__namecall
    oldIndex = gmt.__index

    ourSilentHook = {
        namecall = function(self, ...)
            local method = getnamecallmethod()
            if Config.Aimbot.SilentEnabled and Config.Aimbot.Enabled and not isUnloaded then
                if (method == "Raycast" or method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList") and self == workspace then
                    if currentTarget and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                        if math.random(1,100) <= Config.Aimbot.HitChance then
                            local args = {...}
                            local origin = args[1]
                            local adjTarget = currentTarget.Position
                            if Config.Aimbot.RCSEnabled and Config.Aimbot.RCSAdaptiveLearning then
                                adjTarget = applyAdaptiveRCS(adjTarget)
                            end
                            if method == "Raycast" and typeof(origin)=="Vector3" then
                                args[2] = (adjTarget - origin).Unit * CONST.SILENT_RAY_LENGTH
                                return oldNamecall(self, table.unpack(args))
                            elseif method ~= "Raycast" then
                                local oldRay = args[1]
                                args[1] = Ray.new(oldRay.Origin, (adjTarget - oldRay.Origin).Unit * CONST.SILENT_RAY_LENGTH)
                                return oldNamecall(self, table.unpack(args))
                            end
                        end
                    end
                end
            end
            return oldNamecall(self, ...)
        end,
        index = function(self, key)
            if Config.Aimbot.SilentEnabled and Config.Aimbot.Enabled and not isUnloaded and not UIS:GetFocusedTextBox() then
                if typeof(self)=="Instance" and self:IsA("Mouse") then
                    if (key == "Hit" or key == "Target") and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                        if currentTarget and math.random(1,100) <= Config.Aimbot.HitChance then
                            local adjTarget = currentTarget.Position
                            if Config.Aimbot.RCSEnabled and Config.Aimbot.RCSAdaptiveLearning then
                                adjTarget = applyAdaptiveRCS(adjTarget)
                            end
                            if key == "Hit" then
                                return CFrame.new(adjTarget)
                            else
                                return currentTarget
                            end
                        end
                    end
                end
            end
            return oldIndex(self, key)
        end
    }

    setreadonly(gmt, false)
    gmt.__namecall = ourSilentHook.namecall
    gmt.__index = ourSilentHook.index
    setreadonly(gmt, true)
end

local function removeSilentHook()
    if not gmt or not ourSilentHook then return end
    setreadonly(gmt, false)
    if gmt.__namecall == ourSilentHook.namecall then
        gmt.__namecall = oldNamecall
    end
    if gmt.__index == ourSilentHook.index then
        gmt.__index = oldIndex
    end
    setreadonly(gmt, true)
    ourSilentHook = nil
end

-- ===== RAGE ПЕРЕКЛЮЧЕНИЕ (Исправленный Spinbot) =====
local spinGyro = nil

local function createSpinbot()
    local char = LP.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    if spinGyro then destroySpinbot() end

    local align = Instance.new("AlignOrientation")
    align.Mode = Enum.OrientationAlignmentMode.TwoAttachment
    align.MaxTorque = 100000
    align.MaxAngularVelocity = 100
    align.Responsiveness = 100
    align.Parent = hrp

    local att0 = Instance.new("Attachment")
    att0.Parent = hrp
    local att1 = Instance.new("Attachment")
    att1.WorldCFrame = hrp.CFrame
    att1.Parent = hrp -- Безопасная привязка к себе вместо Terrain

    align.Attachment0 = att0
    align.Attachment1 = att1
    spinGyro = { Align = align, Att0 = att0, Att1 = att1 }
end

local function updateSpinbot(dt)
    if not spinGyro then return end
    local char = LP.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local angSpeed = RageConfig.RageFeatures.SpinSpeed * 2 * math.pi
    local newCF = hrp.CFrame * CFrame.Angles(0, angSpeed * dt, 0)
    spinGyro.Att1.WorldCFrame = newCF
end

local function destroySpinbot()
    if spinGyro then
        if spinGyro.Att0 then spinGyro.Att0:Destroy() end
        if spinGyro.Att1 then spinGyro.Att1:Destroy() end
        if spinGyro.Align then spinGyro.Align:Destroy() end
        spinGyro = nil
    end
end

local function switchToRageConfig()
    RageActive = true
    RageConfig.ESP = table.clone(LegitConfig.ESP)
    Config = RageConfig
    if RageConfig.RageFeatures.Spinbot then
        createSpinbot()
    end
end

local function switchToLegitConfig()
    RageActive = false
    Config = LegitConfig
    destroySpinbot()
end

local function applyRageToggle(enabled)
    if enabled then switchToRageConfig() else switchToLegitConfig() end
end

-- ===== ОСНОВНОЙ ЦИКЛ =====
local aimActive = false
local aimKeyPressedTime = 0
local lastAutoFireShot = 0
local lastFrameTime = tick()
local frameDurations = {}
local lastDrawCountUpdate = 0
local drawCountValue = 0

local function updatePredictionCache()
    local now = tick()
    if now - lastPredictionUpdate < CONST.PREDICTION_CACHE_INTERVAL then return end
    lastPredictionUpdate = now
    for plr, data in pairs(playersData) do
        local parts = data.parts
        if not parts then continue end
        local hrp = parts.HumanoidRootPart
        if not hrp then continue end
        local pos = hrp.Position
        local prev = predictionCache[plr]
        if prev then
            local dt = now - prev.time
            if dt > CONST.PREDICTION_MIN_DT then
                local newVel = (pos - prev.pos) / dt
                prev.velocity = prev.velocity * Config.Aimbot.VelocitySmoothing + newVel * (1 - Config.Aimbot.VelocitySmoothing)
            end
            prev.pos = pos
            prev.time = now
        else
            predictionCache[plr] = { pos = pos, velocity = Vector3.zero, time = now }
        end
    end
end

local function getDynamicFOVRadius()
    local baseRadius = Config.Aimbot.FOVRadius
    if not Config.Aimbot.DynamicFOV then return baseRadius end
    local mouseDelta = UIS:GetMouseDelta()
    local mouseSpeed = mouseDelta.Magnitude
    local char = LP.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    local moveSpeed = humanoid and humanoid.MoveDirection.Magnitude or 0
    local factor = math.sqrt(mouseSpeed * CONST.DYNAMIC_FOV_MOUSE_FACTOR + moveSpeed * CONST.DYNAMIC_FOV_MOVE_FACTOR)
    return baseRadius + math.clamp(factor * 15, 0, CONST.DYNAMIC_FOV_MAX_INCREASE)
end

local function updateFOV()
    if not Config.Aimbot.ShowFOV then
        fovDraw.Visible = false
        squareFOV.Visible = false
        return
    end
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local radius = getDynamicFOVRadius()
    local color = Config.Aimbot.FOVColor
    local thickness = Config.Aimbot.FOVThickness
    if Config.Aimbot.FOVShape == "Circle" then
        fovDraw.Position = center
        fovDraw.Radius = radius
        fovDraw.Color = color
        fovDraw.Thickness = thickness
        fovDraw.Filled = Config.Aimbot.FilledFOV
        fovDraw.Transparency = Config.Aimbot.FOVTransparency
        fovDraw.Visible = true
        squareFOV.Visible = false
    else
        local left = center.X - radius
        local top = center.Y - radius
        local right = center.X + radius
        local bottom = center.Y + radius
        squareFOV.PointA = Vector2.new(left, top)
        squareFOV.PointB = Vector2.new(right, top)
        squareFOV.PointC = Vector2.new(right, bottom)
        squareFOV.PointD = Vector2.new(left, bottom)
        squareFOV.Color = color
        squareFOV.Thickness = thickness
        squareFOV.Filled = false
        squareFOV.Transparency = Config.Aimbot.FOVTransparency
        squareFOV.Visible = true
        fovDraw.Visible = false
    end
end

local function updateFrameTimeProfiler()
    if not Config.ESP.ShowFPS then return end
    local now = tick()
    local frameTime = now - lastFrameTime
    table.insert(frameDurations, frameTime)
    if #frameDurations > CONST.FPS_SAMPLE_COUNT then table.remove(frameDurations, 1) end
    local avgTime = 0
    for _, v in ipairs(frameDurations) do avgTime = avgTime + v end
    avgTime = avgTime / #frameDurations
    lastFrameTime = now

    if frameTimeLabel then
        frameTimeLabel.Text = string.format("Frame: %.2f ms", avgTime * 1000)
        frameTimeLabel.Visible = true
    end
end

local function getBestTarget()
    local bestTarget = nil
    local bestScore = -math.huge
    local maxDist = Config.ESP.MaxDistance
    local fovRadius = getDynamicFOVRadius()
    if RageActive and Config.Aimbot.FOVRadius < 500 then fovRadius = 500 end
    local wallCheck = Config.Aimbot.WallCheck

    for plr, data in pairs(playersData) do
        if not data.parts then continue end
        local parts = data.parts
        if Config.Aimbot.TeamCheck and isTeammate(plr) then continue end
        if Config.ESP.HideTeammates and isTeammate(plr) then continue end
        local targetPart = parts[Config.Aimbot.TargetPart]
        local hum = parts.humanoid
        if not targetPart or not hum or hum.Health <= 0 then continue end
        local predictedPos = getPredictedPosition(targetPart)
        local distanceStuds = (Camera.CFrame.Position - predictedPos).Magnitude
        if distanceStuds > maxDist then continue end
        local screenPos, onScreen = Camera:WorldToViewportPoint(predictedPos)
        if not onScreen then continue end
        local distPixels = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
        if distPixels > fovRadius then continue end
        if wallCheck then
            local origin = Camera.CFrame.Position
            local dir = predictedPos - origin
            aimRayParams.FilterDescendantsInstances = { Camera, LP.Character, parts.Character }
            if workspace:Raycast(origin, dir, aimRayParams) then continue end
        end
        local score = 0
        if Config.Aimbot.PriorityMode == "Threat" then
            score = calculateThreatScore(plr, parts)
        elseif Config.Aimbot.PriorityMode == "Distance" then
            score = -distanceStuds
        elseif Config.Aimbot.PriorityMode == "Crosshair" then
            score = -distPixels
        elseif Config.Aimbot.PriorityMode == "Health" then
            score = -hum.Health
        elseif Config.Aimbot.PriorityMode == "Visible" then
            local visible = isVisibleCached(data, parts.Head)
            score = (visible and 500 or 0) - distanceStuds * 0.5
        end
        if score > bestScore then
            bestScore = score
            bestTarget = targetPart
        end
    end
    return bestTarget
end

local function getKillAuraTarget()
    local char = LP.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local myPos = hrp.Position
    local radius = RageConfig.RageFeatures.KillAuraRadius
    local bestTarget = nil
    local bestDist = math.huge
    local wallCheck = Config.Aimbot.WallCheck

    for plr, data in pairs(playersData) do
        if plr == LP then continue end
        local parts = data.parts
        if not parts then continue end
        local targetPart = parts[Config.Aimbot.TargetPart]
        if not targetPart then continue end
        local hum = parts.humanoid
        if not hum or hum.Health <= 0 then continue end
        local dist = (myPos - targetPart.Position).Magnitude
        if dist <= radius then
            if Config.Aimbot.TeamCheck and isTeammate(plr) then continue end
            if wallCheck then
                local origin = Camera.CFrame.Position
                local dir = targetPart.Position - origin
                aimRayParams.FilterDescendantsInstances = { Camera, LP.Character, parts.Character }
                if workspace:Raycast(origin, dir, aimRayParams) then continue end
            end
            if dist < bestDist then
                bestDist = dist
                bestTarget = targetPart
            end
        end
    end
    return bestTarget
end

local function updateAimbotLoop(dt)
    if isUnloaded then return end
    if not Config.Aimbot.Enabled then return end

    if currentRecoilPattern then recordRecoilUpdate() end

    if spinGyro and RageActive and RageConfig.RageFeatures.Spinbot then
        updateSpinbot(dt)
    end

    local pressed = false
    if RageActive and RageConfig.RageFeatures.Triggerbot then
        pressed = true
    else
        local key = Config.Aimbot.AimbotKey
        if key.EnumType == Enum.UserInputType then
            pressed = UIS:IsMouseButtonPressed(key)
        elseif key.EnumType == Enum.KeyCode then
            pressed = UIS:IsKeyDown(key)
        end
    end

    if pressed then
        if not aimActive then
            if aimKeyPressedTime == 0 then aimKeyPressedTime = tick() end
            if tick() - aimKeyPressedTime >= Config.Aimbot.ReactionTime then aimActive = true end
        end
    else
        aimActive = false
        aimKeyPressedTime = 0
    end

    local newTarget = nil
    if aimActive or (RageActive and RageConfig.RageFeatures.AutoFire) or (RageActive and RageConfig.RageFeatures.KillAura) then
        if RageActive and RageConfig.RageFeatures.KillAura then
            newTarget = getKillAuraTarget()
        elseif aimActive then
            newTarget = getBestTarget()
        end
    end

    if not RageActive and Config.Aimbot.TargetSwitchDelay > 0 and newTarget and lockedTarget then
        if newTarget ~= lockedTarget then
            if tick() - lastTargetSwitch < Config.Aimbot.TargetSwitchDelay then
                newTarget = lockedTarget
            else
                lockedTarget = newTarget
                lastTargetSwitch = tick()
            end
        end
    else
        lockedTarget = newTarget
        if newTarget then lastTargetSwitch = tick() end
    end

    currentTarget = lockedTarget

    if RageActive and RageConfig.RageFeatures.AutoFire and currentTarget then
        local now = tick()
        if now - lastAutoFireShot >= CONST.AUTO_FIRE_COOLDOWN then
            if math.random(1,100) <= Config.Aimbot.HitChance then
                if mouse1press and mouse1release then
                    mouse1press()
                    task.wait(0.01) -- Задержка клика для предотвращения античит-флагов
                    mouse1release()
                end
            end
            lastAutoFireShot = now
            recordRecoilStart()
        end
    end

    if Config.Aimbot.CameraEnabled and aimActive and currentTarget then
        local predictedPos = getPredictedPosition(currentTarget)
        local targetPos = predictedPos
        if Config.Aimbot.RCSEnabled and Config.Aimbot.RCSAdaptiveLearning then
            targetPos = applyAdaptiveRCS(targetPos)
        end
        local targetCF = CFrame.new(Camera.CFrame.Position, targetPos)
        Camera.CFrame = applySmoothing(Camera.CFrame, targetCF, currentTarget)
    end
end

-- ===== ESP UPDATE =====
local function updateESP()
    if isUnloaded or not Config.ESP.Enabled then for _,d in pairs(playersData) do hideAll(d) end return end
    local now=os.clock()
    local full=now-lastFullUpdate>=CONST.FULL_UPDATE_INTERVAL
    local skeleton=now-lastSkeletonUpdate>=CONST.SKELETON_INTERVAL
    local text=now-lastTextUpdate>=CONST.TEXT_INTERVAL
    local arrow=now-lastArrowUpdate>=CONST.ARROW_INTERVAL
    if full then
        lastFullUpdate=now
        for plr,d in pairs(playersData) do
            local parts=d.parts
            local hrp=parts and parts.HumanoidRootPart
            local head=parts and parts.Head
            local hum=parts and parts.humanoid
            if not (hrp and head and hum and hum.Health>0 and parts.Character.Parent) then hideAll(d); renderData[plr]=nil; continue end
            if Config.ESP.HideTeammates and isTeammate(plr) then hideAll(d); renderData[plr]=nil; continue end
            local hrpPos,on=Camera:WorldToViewportPoint(hrp.Position)
            if not on then hideAll(d); renderData[plr]=nil; continue end
            local dist=(Camera.CFrame.Position-hrp.Position).Magnitude
            if dist>Config.ESP.MaxDistance or dist<Config.ESP.MinDistance then hideAll(d); renderData[plr]=nil; continue end
            local visible=false
            if Config.ESP.VisibleCheck then visible=isVisibleCached(d,head) end
            local rd=renderData[plr] or {}
            rd.hrpPos=hrpPos; rd.onScreen=on; rd.distance=dist; rd.visible=visible; rd.parts=parts
            renderData[plr]=rd
        end
        if Config.ESP.PriorityTarget then
            local bestScore=-math.huge local bestPlr local maxDist=Config.ESP.MaxDistance local halfW=Camera.ViewportSize.X/2
            for plr,rd in pairs(renderData) do
                if rd and rd.onScreen and not (Config.ESP.HideTeammates and isTeammate(plr)) then
                    local normDist=rd.distance/maxDist
                    local center=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y/2)
                    local distToCenter=(Vector2.new(rd.hrpPos.X,rd.hrpPos.Y)-center).Magnitude
                    local normPixels=distToCenter/halfW
                    local score=(rd.visible and 1 or 0)-normDist-normPixels*0.5
                    if score>bestScore then bestScore=score bestPlr=plr end
                end
            end
            for plr,rd in pairs(renderData) do if rd then rd.priority=(plr==bestPlr) end end
        end
        for plr,rd in pairs(renderData) do local d=playersData[plr] if d and rd then updateBoxPosition(d,rd.parts,rd) end end
    end
    if skeleton then lastSkeletonUpdate=now for plr,rd in pairs(renderData) do local d=playersData[plr] if d and rd then updateSkeletonOptimized(d,rd.parts,rd) end end end
    if text then lastTextUpdate=now for plr,rd in pairs(renderData) do local d=playersData[plr] if d and rd then updateTextOptimized(d,rd.parts,rd) if Config.ESP.ShowTracer then if not d.tracer then d.tracer=getFromPool(drawingPool.tracers,"Line") d.tracer.Thickness=Config.ESP.TracerThickness end if rd.onScreen and rd.distance<=Config.ESP.MaxDistance and rd.distance>=Config.ESP.MinDistance then local sc=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y) local foot=Vector2.new(rd.hrpPos.X,rd.hrpPos.Y+30) d.tracer.From=sc; d.tracer.To=foot d.tracer.Color=rd.priority and Config.ESP.PriorityColor or Config.ESP.TracerColor d.tracer.Visible=true else d.tracer.Visible=false end end end end end
    if arrow then lastArrowUpdate=now for plr,rd in pairs(renderData) do local d=playersData[plr] if d and rd then updateArrowOptimized(d,rd) end end end
end

-- ===== FPS =====
local function createFPSDisplay() if fpsLabel then return end local gui=Instance.new("ScreenGui") gui.Name="FPSDisplay" gui.ResetOnSpawn=false gui.Parent=LP:WaitForChild("PlayerGui") fpsLabel=Instance.new("TextLabel",gui) fpsLabel.Size=UDim2.new(0,100,0,20) fpsLabel.Position=UDim2.new(1,-110,0,10) fpsLabel.BackgroundTransparency=1 fpsLabel.TextColor3=Color3.fromRGB(255,255,255) fpsLabel.TextStrokeTransparency=0.5 fpsLabel.Font=Enum.Font.SourceSansBold fpsLabel.TextSize=12 drawCountLabel=Instance.new("TextLabel",gui) drawCountLabel.Size=UDim2.new(0,100,0,20) drawCountLabel.Position=UDim2.new(1,-110,0,30) drawCountLabel.BackgroundTransparency=1 drawCountLabel.TextColor3=Color3.fromRGB(200,200,200) drawCountLabel.Font=Enum.Font.SourceSans drawCountLabel.TextSize=10 frameTimeLabel=Instance.new("TextLabel",gui) frameTimeLabel.Size=UDim2.new(0,100,0,20) frameTimeLabel.Position=UDim2.new(1,-110,0,50) frameTimeLabel.BackgroundTransparency=1 frameTimeLabel.TextColor3=Color3.fromRGB(200,200,200) frameTimeLabel.Font=Enum.Font.SourceSans frameTimeLabel.TextSize=10 end
local function updateFPSDisplay(dt) if not Config.ESP.ShowFPS then if fpsLabel then fpsLabel.Visible=false end if drawCountLabel then drawCountLabel.Visible=false end if frameTimeLabel then frameTimeLabel.Visible=false end return end if not fpsLabel then createFPSDisplay() end fpsLabel.Visible=true drawCountLabel.Visible=true if frameTimeLabel then frameTimeLabel.Visible=true end local inst=1/dt fpsSum=fpsSum+inst fpsCount=fpsCount+1 if fpsCount>=CONST.FPS_SAMPLE_COUNT then currentFPS=fpsSum/fpsCount fpsSum=0 fpsCount=0 end
    if tick() - lastDrawCountUpdate > CONST.DRAW_COUNT_UPDATE_INTERVAL then
        drawCountValue = 0
        for _,p in pairs(drawingPool) do drawCountValue = drawCountValue + #p end
        lastDrawCountUpdate = tick()
    end
    drawCountLabel.Text=string.format("Draw: %d", drawCountValue)
    fpsLabel.Text=string.format("FPS: %.1f",currentFPS)
    updateFrameTimeProfiler()
end

