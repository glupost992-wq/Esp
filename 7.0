        Enabled = true,
        BoxType = "2D",
        BoxColor = Color3.fromRGB(0,255,0),
        BoxThickness = 2,
        Skeleton = false,
        SkeletonColor = Color3.fromRGB(255,0,0),
        SkeletonThickness = 2,
        HideTeammates = false,
        MaxDistance = 500,
